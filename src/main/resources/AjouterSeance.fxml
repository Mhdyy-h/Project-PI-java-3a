<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AjouterSeanceController"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="22"
          style="-fx-background-color: linear-gradient(to bottom right, #f0e6ff, #ffffff, #fff8e7);
                 -fx-padding: 45;">

        <!-- ═══ HEADER ═══ -->
        <VBox style="-fx-background-color: linear-gradient(to right, #4a235a, #7d3c98);
                     -fx-background-radius: 20; -fx-padding: 25 30;
                     -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.5), 25, 0, 0, 8);">
            <HBox spacing="18" alignment="CENTER_LEFT">
                <Label text="🏃" style="-fx-font-size: 45px;"/>
                <VBox spacing="5">
                    <Label text="Ajouter une Séance Sport"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Validation en temps réel — tous les champs sont vérifiés"
                           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ═══ SECTION 1 : Informations principales ═══ -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 18;
                     -fx-padding: 28;
                     -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.12), 20, 0, 0, 6);">

            <Label text="📋  Informations principales"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4a235a;
                          -fx-border-color: #d4af37; -fx-border-width: 0 0 0 4;
                          -fx-padding: 4 0 4 12;"/>

            <!-- Nom -->
            <VBox spacing="4">
                <Label text="📝  Nom de la séance"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                <TextField fx:id="nomField"
                           promptText="Ex: Cardio Matin"
                           maxWidth="Infinity"
                           style="-fx-background-color: #faf8ff; -fx-text-fill: #4a235a;
                                  -fx-border-color: #d4af37; -fx-border-radius: 12;
                                  -fx-background-radius: 12; -fx-pref-height: 46;
                                  -fx-font-size: 13px; -fx-padding: 0 16;"/>
                <Label fx:id="errNom" text=""
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </VBox>

            <!-- Heure début + Durée -->
            <HBox spacing="20">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="⏰  Heure début"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                    <TextField fx:id="heureDebutField" promptText="Ex: 08:30:00"
                               maxWidth="Infinity"
                               style="-fx-background-color: #f0f9ff; -fx-text-fill: #4a235a;
                                      -fx-border-color: #1a6b8a; -fx-border-radius: 12;
                                      -fx-background-radius: 12; -fx-pref-height: 46;
                                      -fx-font-size: 13px; -fx-padding: 0 16;"/>
                    <Label fx:id="errHeure" text=""
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="⏱️  Durée (minutes)"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                    <TextField fx:id="dureeField" promptText="Ex: 45, 60, 90..."
                               maxWidth="Infinity"
                               style="-fx-background-color: #f0fff6; -fx-text-fill: #4a235a;
                                      -fx-border-color: #27ae60; -fx-border-radius: 12;
                                      -fx-background-radius: 12; -fx-pref-height: 46;
                                      -fx-font-size: 13px; -fx-padding: 0 16;"/>
                    <Label fx:id="errDuree" text=""
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
                </VBox>
            </HBox>

            <!-- Date -->
            <VBox spacing="4">
                <Label text="📅  Date de la séance"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                <TextField fx:id="dateField" promptText="YYYY-MM-DD  (ex: 2026-04-10)"
                           maxWidth="Infinity"
                           style="-fx-background-color: #fff8f0; -fx-text-fill: #4a235a;
                                  -fx-border-color: #e67e22; -fx-border-radius: 12;
                                  -fx-background-radius: 12; -fx-pref-height: 46;
                                  -fx-font-size: 13px; -fx-padding: 0 16;"/>
                <Label fx:id="errDate" text=""
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </VBox>

        </VBox>

        <!-- ═══ SECTION 2 : Détails ═══ -->
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-background-radius: 18;
                     -fx-padding: 28;
                     -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.12), 20, 0, 0, 6);">

            <Label text="⚙️  Détails supplémentaires"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4a235a;
                          -fx-border-color: #7d3c98; -fx-border-width: 0 0 0 4;
                          -fx-padding: 4 0 4 12;"/>

            <!-- Médaille -->
            <VBox spacing="4">
                <Label text="🥇  Médaille obtenue"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                <ComboBox fx:id="medailleBox" promptText="Choisir une médaille..."
                          maxWidth="Infinity"
                          style="-fx-background-color: #fffdf0;
                                 -fx-border-color: #d4af37; -fx-border-radius: 12;
                                 -fx-background-radius: 12; -fx-pref-height: 46;
                                 -fx-font-size: 13px;"/>
                <Label fx:id="errMedaille" text=""
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </VBox>

            <!-- ID Utilisateur + Heure réelle -->
            <HBox spacing="20">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="👤  ID Utilisateur"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                    <TextField fx:id="utilisateurIdField" promptText="Ex: 1, 2, 15..."
                               maxWidth="Infinity"
                               style="-fx-background-color: #fdf0ff; -fx-text-fill: #4a235a;
                                      -fx-border-color: #8e44ad; -fx-border-radius: 12;
                                      -fx-background-radius: 12; -fx-pref-height: 46;
                                      -fx-font-size: 13px; -fx-padding: 0 16;"/>
                    <Label fx:id="errUtilisateur" text=""
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="🕐  Heure réelle (optionnelle)"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                    <TextField fx:id="heureDebutReelleField"
                               promptText="Laisser vide si inconnue"
                               maxWidth="Infinity"
                               style="-fx-background-color: #f0f7ff; -fx-text-fill: #4a235a;
                                      -fx-border-color: #2980b9; -fx-border-radius: 12;
                                      -fx-background-radius: 12; -fx-pref-height: 46;
                                      -fx-font-size: 13px; -fx-padding: 0 16;"/>
                    <Label fx:id="errHeureReelle" text="(optionnel)"
                           style="-fx-font-size: 11px; -fx-text-fill: #9b89a8; -fx-padding: 0 0 0 5;"/>
                </VBox>
            </HBox>

            <!-- Alerte -->
            <VBox spacing="4">
                <Label text="🔔  Alerte envoyée"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
                <ComboBox fx:id="alerteBox" promptText="Choisir le statut de l'alerte..."
                          maxWidth="Infinity"
                          style="-fx-background-color: #fff0f3;
                                 -fx-border-color: #e94560; -fx-border-radius: 12;
                                 -fx-background-radius: 12; -fx-pref-height: 46;
                                 -fx-font-size: 13px;"/>
                <Label fx:id="errAlerte" text=""
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 0 5;"/>
            </VBox>

        </VBox>

        <!-- ═══ MESSAGE GLOBAL ═══ -->
        <Label fx:id="messageLabel" text=""
               maxWidth="Infinity"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 5 10;
                      -fx-background-radius: 10; -fx-background-color: transparent;"/>

        <!-- ═══ BOUTONS ═══ -->
        <HBox spacing="15"
              style="-fx-background-color: white; -fx-background-radius: 18;
                     -fx-padding: 20 25;
                     -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.1), 15, 0, 0, 4);">
            <Button text="✅  Ajouter la séance" onAction="#ajouterSeance"
                    style="-fx-background-color: linear-gradient(to right, #4a235a, #7d3c98);
                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-pref-width: 200; -fx-pref-height: 46;
                           -fx-background-radius: 14; -fx-cursor: hand;"/>
            <Button fx:id="btnAfficher" text="📋  Voir la liste" onAction="#naviguerVersAfficher"
                    style="-fx-background-color: white; -fx-text-fill: #4a235a;
                           -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-pref-width: 160; -fx-pref-height: 46;
                           -fx-background-radius: 14; -fx-cursor: hand;
                           -fx-border-color: #d4af37; -fx-border-width: 2;
                           -fx-border-radius: 14;"/>
            <Button fx:id="btnMenu" text="🏠  Menu" onAction="#ouvrirMenu"
                    style="-fx-background-color: linear-gradient(to right, #d4af37, #b8960c);
                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-pref-width: 130; -fx-pref-height: 46;
                           -fx-background-radius: 14; -fx-cursor: hand;"/>
            <Button text="🤖  Analyse IA" onAction="#lancerAnalyseIA"
                    style="-fx-background-color: linear-gradient(to right, #1a6b8a, #2980b9);
                           -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-pref-width: 160; -fx-pref-height: 46;
                           -fx-background-radius: 14; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</ScrollPane>