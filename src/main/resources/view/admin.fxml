<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AdminController"
      prefWidth="1200" prefHeight="780"
      style="-fx-background-color: #f4f1fb;"
      stylesheets="@style.css">

    <!-- ══════════ SIDEBAR ══════════ -->
    <VBox prefWidth="220"
          style="-fx-background-color: white;
                 -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.12), 15, 0, 0, 0);
                 -fx-padding: 0;">

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #2d1b69; -fx-padding: 28 20;">
            <Label text="⚙️" style="-fx-font-size: 32px;"/>
            <Label text="BACK OFFICE"
                   style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Label text="Administration"
                   style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 11px;"/>
        </VBox>

        <!-- Menu items -->
        <VBox spacing="4" style="-fx-padding: 20 12;">

            <Button text="  📊  Dashboard" onAction="#showDashboard"
                    fx:id="btnDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #f0ebff; -fx-text-fill: #2d1b69;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-padding: 12 16; -fx-alignment: CENTER_LEFT;
                           -fx-border-color: #2d1b69; -fx-border-radius: 10; -fx-border-width: 2;"/>

            <Button text="  🏃  Séances" onAction="#showSeances"
                    fx:id="btnSeances" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555;
                           -fx-font-size: 13px; -fx-background-radius: 10;
                           -fx-cursor: hand; -fx-padding: 12 16;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="  💪  Exercices" onAction="#showExercices"
                    fx:id="btnExercices" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #555;
                           -fx-font-size: 13px; -fx-background-radius: 10;
                           -fx-cursor: hand; -fx-padding: 12 16;
                           -fx-alignment: CENTER_LEFT;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Fermer -->
        <VBox style="-fx-padding: 12;">
            <Button text="✕  Fermer" onAction="#fermerFenetre"
                    maxWidth="Infinity"
                    style="-fx-background-color: #ffe8ec; -fx-text-fill: #e94560;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-padding: 10 16; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </VBox>

    <!-- ══════════ CONTENU PRINCIPAL ══════════ -->
    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">

        <!-- Topbar -->
        <HBox style="-fx-background-color: white; -fx-padding: 16 28;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
              alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="topBarTitle" text="📊 Dashboard"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d1b69;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Admin"
                   style="-fx-background-color: #f0ebff; -fx-text-fill: #2d1b69;
                          -fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-background-radius: 20; -fx-padding: 4 14;"/>
        </HBox>

        <!-- Zone de contenu dynamique -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox fx:id="contentArea" spacing="24" style="-fx-padding: 28;">

                <!-- ═══ DASHBOARD (visible par défaut) ═══ -->
                <VBox fx:id="paneDashboard" spacing="20">

                    <!-- Stats cards -->
                    <HBox spacing="16">
                        <VBox fx:id="cardSeances"
                              style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-pref-width: 200;
                                     -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.10),12,0,0,3);"
                              spacing="8" alignment="CENTER">
                            <Label text="🏃"
                                   style="-fx-font-size: 28px;"/>
                            <Label fx:id="statSeances" text="0"
                                   style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #2d1b69;"/>
                            <Label text="Séances"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-pref-width: 200;
                                     -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.10),12,0,0,3);"
                              spacing="8" alignment="CENTER">
                            <Label text="💪" style="-fx-font-size: 28px;"/>
                            <Label fx:id="statExercices" text="0"
                                   style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #7d3c98;"/>
                            <Label text="Exercices"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-pref-width: 260;
                                     -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.10),12,0,0,3);"
                              spacing="8" alignment="CENTER">
                            <Label text="🏅" style="-fx-font-size: 28px;"/>
                            <Label fx:id="statMedailles" text="—"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b8960c;"/>
                            <Label text="Médailles"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                                     -fx-padding: 22; -fx-pref-width: 200;
                                     -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.10),12,0,0,3);"
                              spacing="8" alignment="CENTER">
                            <Label text="🔥" style="-fx-font-size: 28px;"/>
                            <Label fx:id="statCalories" text="—"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                            <Label text="Moy. Calories/min"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
                        </VBox>
                    </HBox>

                    <!-- Raccourcis rapides -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.08),12,0,0,3);"
                          spacing="16">
                        <Label text="⚡ Actions rapides"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2d1b69;"/>
                        <HBox spacing="12">
                            <Button text="➕ Ajouter une séance" onAction="#ajouterSeance"
                                    style="-fx-background-color: #2d1b69; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-cursor: hand; -fx-padding: 10 20;"/>
                            <Button text="➕ Ajouter un exercice" onAction="#ajouterExercice"
                                    style="-fx-background-color: #7d3c98; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-cursor: hand; -fx-padding: 10 20;"/>
                            <Button text="🏃 Voir séances" onAction="#showSeances"
                                    style="-fx-background-color: #f0ebff; -fx-text-fill: #2d1b69;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-cursor: hand; -fx-padding: 10 20;"/>
                            <Button text="💪 Voir exercices" onAction="#showExercices"
                                    style="-fx-background-color: #f5f0ff; -fx-text-fill: #7d3c98;
                                           -fx-font-weight: bold; -fx-background-radius: 10;
                                           -fx-cursor: hand; -fx-padding: 10 20;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ═══ SÉANCES ═══ -->
                <VBox fx:id="paneSeances" spacing="0" managed="false" visible="false"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.08),12,0,0,3);">
                    <HBox style="-fx-padding: 18 22;" alignment="CENTER_LEFT" spacing="12">
                        <Label text="🏃 Gestion des Séances"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2d1b69;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Ajouter" onAction="#ajouterSeance"
                                style="-fx-background-color: #2d1b69; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-cursor: hand; -fx-padding: 8 16;"/>
                    </HBox>
                    <VBox fx:id="tableSeances" spacing="0"/>
                </VBox>

                <!-- ═══ EXERCICES ═══ -->
                <VBox fx:id="paneExercices" spacing="0" managed="false" visible="false"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.08),12,0,0,3);">
                    <HBox style="-fx-padding: 18 22;" alignment="CENTER_LEFT" spacing="12">
                        <Label text="💪 Gestion des Exercices"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #7d3c98;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Ajouter" onAction="#ajouterExercice"
                                style="-fx-background-color: #7d3c98; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-cursor: hand; -fx-padding: 8 16;"/>
                    </HBox>
                    <VBox fx:id="tableExercices" spacing="0"/>
                </VBox>

                <!-- ═══ FORMULAIRE AJOUTER SÉANCE ═══ -->
                <ScrollPane fx:id="paneAjouterSeance" fitToWidth="true"
                            managed="false" visible="false"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="contenuAjouterSeance" spacing="0"/>
                </ScrollPane>

                <!-- ═══ FORMULAIRE MODIFIER SÉANCE ═══ -->
                <ScrollPane fx:id="paneModifierSeance" fitToWidth="true"
                            managed="false" visible="false"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="contenuModifierSeance" spacing="0"/>
                </ScrollPane>

                <!-- ═══ FORMULAIRE AJOUTER EXERCICE ═══ -->
                <ScrollPane fx:id="paneAjouterExercice" fitToWidth="true"
                            managed="false" visible="false"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="contenuAjouterExercice" spacing="0"/>
                </ScrollPane>

                <!-- ═══ FORMULAIRE MODIFIER EXERCICE ═══ -->
                <ScrollPane fx:id="paneModifierExercice" fitToWidth="true"
                            managed="false" visible="false"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="contenuModifierExercice" spacing="0"/>
                </ScrollPane>

                <!-- ═══ PAGE CONFIRMATION SUPPRESSION ═══ -->
                <VBox fx:id="paneConfirmSuppr" managed="false" visible="false"
                      alignment="CENTER" spacing="0">
                    <VBox alignment="CENTER" spacing="24"
                          style="-fx-background-color: white; -fx-background-radius: 20;
                                 -fx-padding: 50 60;
                                 -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.15),20,0,0,5);"
                          maxWidth="500">
                        <Label text="🗑️"
                               style="-fx-font-size: 56px;"/>
                        <Label text="Confirmer la suppression"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d1b69;"/>
                        <VBox fx:id="detailsSuppr" spacing="8" alignment="CENTER"
                              style="-fx-background-color: #fdf4f4; -fx-background-radius: 12;
                                     -fx-padding: 18 24;">
                            <Label fx:id="supprType" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
                            <Label fx:id="supprNom" text=""
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
                            <Label fx:id="supprDetail" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                        </VBox>
                        <Label text="Cette action est irréversible."
                               style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>
                        <HBox spacing="16" alignment="CENTER">
                            <Button text="✕  Annuler" onAction="#annulerSuppression"
                                    style="-fx-background-color: white; -fx-text-fill: #555;
                                           -fx-font-size: 14px; -fx-font-weight: bold;
                                           -fx-pref-width: 150; -fx-pref-height: 46;
                                           -fx-background-radius: 12; -fx-cursor: hand;
                                           -fx-border-color: #ddd; -fx-border-width: 2;
                                           -fx-border-radius: 12;"/>
                            <Button text="🗑️  Supprimer" onAction="#confirmerSuppression"
                                    style="-fx-background-color: #e94560; -fx-text-fill: white;
                                           -fx-font-size: 14px; -fx-font-weight: bold;
                                           -fx-pref-width: 150; -fx-pref-height: 46;
                                           -fx-background-radius: 12; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>