<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="25" alignment="CENTER"
      style="-fx-background-color: #f8f6ff; -fx-padding: 60;"
      stylesheets="@style.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.SupprimerExerciceController">

    <Label text="🗑️" style="-fx-font-size: 60px;"/>

    <VBox alignment="CENTER" spacing="8">
        <Label text="Supprimer un Exercice"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e94560;"/>
        <Label text="Cette action est irréversible !"
               style="-fx-font-size: 13px; -fx-text-fill: #9b89a8;"/>
    </VBox>

    <Label text="──────────────────────────────────────────"
           style="-fx-text-fill: #e94560; -fx-opacity: 0.3;"/>

    <VBox spacing="12" alignment="CENTER"
          style="-fx-background-color: white; -fx-padding: 25;
                 -fx-border-color: #e8dff5; -fx-border-radius: 15;
                 -fx-background-radius: 15;
                 -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.1), 15, 0, 0, 4);">
        <Label text="Vous allez supprimer l'exercice :"
               style="-fx-font-size: 13px; -fx-text-fill: #9b89a8;"/>
        <Label fx:id="nomLabel"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
        <HBox spacing="20" alignment="CENTER">
            <Label fx:id="intensiteLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #9b89a8;"/>
            <Label text="•" style="-fx-text-fill: #d4af37;"/>
            <Label fx:id="caloriesLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #9b89a8;"/>
        </HBox>
    </VBox>

    <Label fx:id="messageLabel"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnConfirmer" text="🗑️  Confirmer la suppression"
                onAction="#confirmerSuppression"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 230; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>
        <Button fx:id="btnAnnuler" text="◀  Annuler" onAction="#annuler"
                style="-fx-background-color: white; -fx-text-fill: #4a235a;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 140; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;
                       -fx-border-color: #7d3c98; -fx-border-width: 2;
                       -fx-border-radius: 12;"/>
        <Button fx:id="btnMenu" text="🏠  Menu" onAction="#ouvrirMenu"
                style="-fx-background-color: #4a235a; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 120; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>
    </HBox>

</VBox>