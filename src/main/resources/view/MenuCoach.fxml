<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.MenuCoachController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../styles/style.css">

    <left>
        <VBox prefWidth="200" minWidth="200"
              style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,2,0);">

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 24 20;
                         -fx-border-color: transparent transparent #f0f2f8 transparent;
                         -fx-border-width: 0 0 1 0;">
                <Circle radius="16" fill="#1a0f4f"/>
                <Label text="Gestion Sport"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;
                              -fx-text-fill: #1a0f4f;"/>
            </HBox>

            <VBox spacing="2" style="-fx-padding: 16 12;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      style="-fx-background-color: #f0f2f8;">
                    <Label text="⊞" style="-fx-font-size: 16px;"/>
                    <Label text="Dashboard"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a0f4f;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirSeances"
                      style="-fx-cursor: hand;">
                    <Label text="🏃" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Séances"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #c9a227;"/>
                        <Label text="Gestion séances"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirMesUsers"
                      style="-fx-cursor: hand;">
                    <Label text="👥" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Mes Athlètes"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #7d3c98;"/>
                        <Label text="Gestion athlètes"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirProgression"
                      style="-fx-cursor: hand;">
                    <Label text="📊" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Progression"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #44cc88;"/>
                        <Label text="Analyse athlètes"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- ✅ Nav Analyse IA — DANS le VBox nav -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirAnalyseIAMouse"
                      style="-fx-cursor: hand;">
                    <Label text="🤖" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Analyse IA"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a6b8a;"/>
                        <Label text="IA séances"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox style="-fx-border-color: #f0f2f8 transparent transparent transparent;
                         -fx-border-width: 1 0 0 0; -fx-padding: 16 20;" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="18" fill="#c9a227"/>
                    <VBox spacing="1">
                        <Label text="Coach" styleClass="user-name"/>
                        <Label text="Gestion séances" styleClass="user-email"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 36;">

                <VBox spacing="4">
                    <Label text="Dashboard — Coach"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a0f4f;"/>
                    <Label text="Gérez vos séances et vos athlètes"
                           styleClass="user-email"/>
                </VBox>

                <!-- STATS -->
                <HBox spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="20" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24 30;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #fff8e7;
                                          -fx-background-radius: 14;">
                            <Label text="🏃" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="totalSeancesLabel" text="—"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #c9a227;"/>
                            <Label text="Total Séances" styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="20" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24 30;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #e8f8f0;
                                          -fx-background-radius: 14;">
                            <Label text="⏱️" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="moyenneDureeLabel" text="—"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #1a8a5a;"/>
                            <Label text="Min / Séance" styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="20" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24 30;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #fff0f3;
                                          -fx-background-radius: 14;">
                            <Label text="🥇" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="totalMedaillesLabel" text="—"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #e94560;"/>
                            <Label text="Médailles Or" styleClass="user-email"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- CARTES ACTIONS -->
                <HBox spacing="20">

                    <VBox spacing="16" alignment="CENTER" HBox.hgrow="ALWAYS"
                          styleClass="card-validations-pro"
                          style="-fx-cursor: hand;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #fff8e7;
                                          -fx-background-radius: 16;">
                            <Label text="🏃" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Séances Sport"
                                   styleClass="user-name" style="-fx-font-size: 15px;"/>
                            <Label text="Gérer vos séances d'entraînement"
                                   styleClass="user-email" wrapText="true"/>
                        </VBox>
                        <Button text="Accéder →"
                                onAction="#ouvrirSeancesNav"
                                styleClass="btn-primary"/>
                    </VBox>

                    <VBox spacing="16" alignment="CENTER" HBox.hgrow="ALWAYS"
                          styleClass="card-validations-pro"
                          style="-fx-cursor: hand; -fx-border-color: #7d3c98;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #f0e6ff;
                                          -fx-background-radius: 16;">
                            <Label text="👥" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Mes Athlètes"
                                   styleClass="user-name" style="-fx-font-size: 15px;"/>
                            <Label text="Assigner et gérer vos athlètes"
                                   styleClass="user-email" wrapText="true"/>
                        </VBox>
                        <Button text="Voir →"
                                onAction="#ouvrirMesUsers"
                                styleClass="btn-primary"/>
                    </VBox>

                    <VBox spacing="16" alignment="CENTER" HBox.hgrow="ALWAYS"
                          styleClass="card-validations-pro"
                          style="-fx-cursor: hand; -fx-border-color: #44cc88;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #e6fff5;
                                          -fx-background-radius: 16;">
                            <Label text="📊" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Progression"
                                   styleClass="user-name" style="-fx-font-size: 15px;"/>
                            <Label text="Analyser la progression de vos athlètes"
                                   styleClass="user-email" wrapText="true"/>
                        </VBox>
                        <Button text="Analyser →"
                                onAction="#ouvrirProgression"
                                styleClass="btn-primary"/>
                    </VBox>

                    <!-- ✅ Carte Analyse IA — DANS le HBox cartes -->
                    <VBox spacing="16" alignment="CENTER" HBox.hgrow="ALWAYS"
                          styleClass="card-validations-pro"
                          style="-fx-cursor: hand; -fx-border-color: #1a6b8a;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #e0f4ff;
                                          -fx-background-radius: 16;">
                            <Label text="🤖" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Analyse IA"
                                   styleClass="user-name" style="-fx-font-size: 15px;"/>
                            <Label text="Analyser les séances avec l'IA"
                                   styleClass="user-email" wrapText="true"/>
                        </VBox>
                        <Button text="Analyser →"
                                onAction="#ouvrirAnalyseIA"
                                style="-fx-background-color: #1a6b8a;"
                                styleClass="btn-primary"/>
                    </VBox>

                </HBox>

                <!-- Messagerie -->
                <VBox spacing="16" alignment="CENTER"
                      styleClass="card-validations-pro"
                      style="-fx-cursor: hand; -fx-border-color: #1a6b8a;">
                    <StackPane minWidth="60" minHeight="60"
                               style="-fx-background-color: #e0f4ff; -fx-background-radius: 16;">
                        <Label text="💬" style="-fx-font-size: 26px;"/>
                    </StackPane>
                    <VBox spacing="6" alignment="CENTER">
                        <Label text="Messagerie" styleClass="user-name" style="-fx-font-size: 15px;"/>
                        <Label text="Chat avec vos athlètes" styleClass="user-email" wrapText="true"/>
                    </VBox>
                    <Button text="Ouvrir →" onAction="#ouvrirMessagerie"
                            style="-fx-background-color: #1a6b8a;" styleClass="btn-primary"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>