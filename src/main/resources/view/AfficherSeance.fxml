<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18"
      style="-fx-background-color: #f8f6ff; -fx-padding: 40;"
      stylesheets="@style.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.AfficherSeanceController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🏃" style="-fx-font-size: 36px;"/>
        <VBox spacing="3">
            <Label text="Liste des Séances Sport"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;
                          -fx-text-fill: #4a235a;"/>
            <Label text="Consultez, modifiez ou supprimez vos séances"
                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
        </VBox>
    </HBox>

    <Label text="──────────────────────────────────────────"
           style="-fx-text-fill: #d4af37; -fx-opacity: 0.5;"/>

    <!-- Recherche + Filtres -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="rechercheField" promptText="🔍  Rechercher par nom..."
                   prefWidth="260" prefHeight="38"
                   style="-fx-background-color: white; -fx-text-fill: #4a235a;
                          -fx-border-color: #7d3c98; -fx-border-radius: 10;
                          -fx-background-radius: 10; -fx-font-size: 13px;
                          -fx-padding: 0 12;"/>
        <ComboBox fx:id="filtreMedaille" promptText="🥇 Médaille"
                  prefHeight="38" prefWidth="150"
                  style="-fx-background-color: white; -fx-border-color: #d4af37;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-font-size: 13px;"/>
        <ComboBox fx:id="filtreDuree" promptText="⏱️ Durée"
                  prefHeight="38" prefWidth="150"
                  style="-fx-background-color: white; -fx-border-color: #d4af37;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-font-size: 13px;"/>
        <Button fx:id="btnReset" text="✖  Réinitialiser"
                onAction="#reinitialiserFiltres"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 38; -fx-pref-width: 130;
                       -fx-background-radius: 10; -fx-cursor: hand;"/>
    </HBox>

    <!-- Boutons Tri -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Trier par :"
               style="-fx-font-size: 13px; -fx-font-weight: bold;
                      -fx-text-fill: #4a235a;"/>
        <Button fx:id="btnTriNomAZ" text="🏷️ Nom A→Z"
                onAction="#trierNomAZ"
                style="-fx-background-color: #f0e6ff; -fx-text-fill: #4a235a;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 34; -fx-pref-width: 120;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #7d3c98; -fx-border-width: 1.5;
                       -fx-border-radius: 8;"/>
        <Button fx:id="btnTriNomZA" text="🏷️ Nom Z→A"
                onAction="#trierNomZA"
                style="-fx-background-color: #f0e6ff; -fx-text-fill: #4a235a;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 34; -fx-pref-width: 120;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #7d3c98; -fx-border-width: 1.5;
                       -fx-border-radius: 8;"/>
        <Button fx:id="btnTriDureeAsc" text="⏱️ Durée ↑"
                onAction="#trierDureeAsc"
                style="-fx-background-color: #fff8e6; -fx-text-fill: #b8960c;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 34; -fx-pref-width: 105;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #d4af37; -fx-border-width: 1.5;
                       -fx-border-radius: 8;"/>
        <Button fx:id="btnTriDureeDesc" text="⏱️ Durée ↓"
                onAction="#trierDureeDesc"
                style="-fx-background-color: #fff8e6; -fx-text-fill: #b8960c;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 34; -fx-pref-width: 105;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #d4af37; -fx-border-width: 1.5;
                       -fx-border-radius: 8;"/>
        <Button fx:id="btnTriDateRecent" text="📅 Date récente"
                onAction="#trierDateRecent"
                style="-fx-background-color: #e8f8f0; -fx-text-fill: #1a6b3c;
                       -fx-font-size: 12px; -fx-font-weight: bold;
                       -fx-pref-height: 34; -fx-pref-width: 130;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #27ae60; -fx-border-width: 1.5;
                       -fx-border-radius: 8;"/>
    </HBox>

    <!-- Compteur -->
    <Label fx:id="compteurLabel"
           style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;
                  -fx-font-style: italic;"/>

    <!-- Cards ScrollPane -->
    <ScrollPane fitToWidth="true" prefHeight="420"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;">
        <FlowPane fx:id="cardsContainer"
                  hgap="16" vgap="16"
                  style="-fx-padding: 10;
                         -fx-background-color: transparent;"/>
    </ScrollPane>

    <!-- Boutons action -->
    <HBox spacing="12">
        <Button fx:id="btnAjouter" text="➕  Ajouter"
                onAction="#ouvrirAjouter"
                style="-fx-background-color: #4a235a;
                       -fx-text-fill: white; -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-pref-width: 135; -fx-pref-height: 42;
                       -fx-background-radius: 10; -fx-cursor: hand;"/>
        <Button fx:id="btnMenu" text="🏠  Menu"
                onAction="#ouvrirMenu"
                style="-fx-background-color: white; -fx-text-fill: #4a235a;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-pref-width: 115; -fx-pref-height: 42;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-border-color: #4a235a; -fx-border-width: 2;
                       -fx-border-radius: 10;"/>
    </HBox>

    <Label fx:id="messageLabel"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

</VBox>