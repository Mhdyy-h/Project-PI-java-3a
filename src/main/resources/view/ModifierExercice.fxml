<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      style="-fx-background-color: #f8f6ff; -fx-padding: 50;"
      stylesheets="@../styles/style.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.ModifierExerciceController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="✏️" style="-fx-font-size: 38px;"/>
        <VBox spacing="3">
            <Label text="Modifier un Exercice"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #b8960c;"/>
            <Label text="Modifiez les informations de l'exercice sélectionné"
                   style="-fx-font-size: 12px; -fx-text-fill: #9b89a8;"/>
        </VBox>
    </HBox>

    <Label text="──────────────────────────────────────────"
           style="-fx-text-fill: #d4af37; -fx-opacity: 0.5;"/>

    <!-- Nom seul sur toute la largeur -->
    <VBox spacing="6">
        <Label text="📝  Nom de l'exercice"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
        <TextField fx:id="nomField" promptText="Ex: Pompes, Squat..."
                   style="-fx-background-color: white; -fx-text-fill: #4a235a;
                          -fx-border-color: #d4af37; -fx-border-radius: 10;
                          -fx-background-radius: 10; -fx-pref-height: 45;
                          -fx-font-size: 14px; -fx-padding: 0 15;"/>
    </VBox>

    <!-- Intensité seule sur toute la largeur -->
    <VBox spacing="6">
        <Label text="⚡  Intensité"
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
        <ComboBox fx:id="intensiteBox"
                  style="-fx-background-color: white; -fx-text-fill: #4a235a;
                         -fx-border-color: #d4af37; -fx-border-radius: 10;
                         -fx-background-radius: 10; -fx-pref-height: 45;
                         -fx-pref-width: 9999; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Calories + ID Séance côte à côte -->
    <HBox spacing="20">
        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
            <Label text="🔥  Calories par minute"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
            <TextField fx:id="caloriesField" promptText="Ex: 8.5, 12.0..."
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: white; -fx-text-fill: #4a235a;
                              -fx-border-color: #d4af37; -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-pref-height: 45;
                              -fx-font-size: 14px; -fx-padding: 0 15;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
            <Label text="🏋️  ID Séance"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4a235a;"/>
            <TextField fx:id="seanceIdField" promptText="Ex: 1, 2, 3..."
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: white; -fx-text-fill: #4a235a;
                              -fx-border-color: #d4af37; -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-pref-height: 45;
                              -fx-font-size: 14px; -fx-padding: 0 15;"/>
        </VBox>
    </HBox>

    <!-- Message feedback -->
    <Label fx:id="messageLabel"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <!-- Boutons -->
    <HBox spacing="12">
        <Button fx:id="btnSauvegarder" text="💾  Sauvegarder" onAction="#sauvegarder"
                style="-fx-background-color: linear-gradient(to right, #d4af37, #b8960c);
                       -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 185; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>
        <Button fx:id="btnRetour" text="◀  Retour" onAction="#retour"
                style="-fx-background-color: white; -fx-text-fill: #4a235a;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 150; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;
                       -fx-border-color: #7d3c98; -fx-border-width: 2;
                       -fx-border-radius: 12;"/>
        <Button fx:id="btnMenu" text="🏠  Menu" onAction="#ouvrirMenu"
                style="-fx-background-color: #4a235a; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-pref-width: 130; -fx-pref-height: 45;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>
    </HBox>

</VBox>