<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.QuizViewController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@style.css">

    <!-- ===== BARRE SUPÉRIEURE : progression + fatigue + timer ===== -->
    <top>
        <VBox style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 4, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-padding: 14 32;">

                <!-- Bouton quitter -->
                <Button text="← Quitter"
                        onAction="#quitterSession"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;"/>

                <!-- Progression texte -->
                <Label fx:id="labelProgression" text="Question 1 / 10"
                       style="-fx-font-size: 14px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a0f4f;"/>

                <!-- Barre de progression -->
                <ProgressBar fx:id="barreProgression" progress="0"
                             HBox.hgrow="ALWAYS"
                             style="-fx-accent: #1a0f4f;
                                    -fx-background-radius: 8;"/>

                <!-- Thème -->
                <Label fx:id="labelTheme" text="Informatique"
                       style="-fx-background-color: #ede9fe;
                              -fx-background-radius: 20;
                              -fx-text-fill: #7c3aed;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 4 12;"/>

                <!-- Indicateur fatigue -->
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: #f9fafb;
                             -fx-background-radius: 8;
                             -fx-padding: 6 12;">
                    <Label text="⚡" style="-fx-font-size: 12px;"/>
                    <Label fx:id="labelFatigue" text="Fatigue : 0%"
                           style="-fx-font-size: 12px; -fx-text-fill: #16a34a;"/>
                </HBox>

                <!-- Timer -->
                <StackPane minWidth="64" minHeight="64"
                           style="-fx-background-color: #1a0f4f;
                                  -fx-background-radius: 50%;">
                    <Label fx:id="labelTimer" text="30"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: white;"/>
                </StackPane>
            </HBox>

            <!-- Barre fine de temps restant (animée) -->
            <ProgressBar fx:id="barreTimer" progress="1.0" maxWidth="Infinity"
                         prefHeight="4"
                         style="-fx-accent: #2563eb; -fx-background-color: #e5e7eb;"/>
        </VBox>
    </top>

    <!-- ===== CONTENU CENTRAL ===== -->
    <center>
        <StackPane>

            <!-- ── Vue QUESTION ── -->
            <VBox fx:id="vueQuestion" alignment="CENTER" spacing="28"
                  style="-fx-padding: 40 80;"
                  visible="true" managed="true">

                <!-- Carte question -->
                <VBox spacing="20"
                      style="-fx-background-color: white;
                             -fx-background-radius: 20;
                             -fx-padding: 36 40;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 4);"
                      maxWidth="800">

                    <!-- Badge difficulté -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="labelDifficulte" text="Niveau 5"
                               style="-fx-background-color: #fef3c7;
                                      -fx-background-radius: 20;
                                      -fx-text-fill: #d97706;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 11px;
                                      -fx-padding: 3 10;"/>
                        <Label fx:id="labelTypeQuestion" text="QCM"
                               style="-fx-background-color: #eff6ff;
                                      -fx-background-radius: 20;
                                      -fx-text-fill: #2563eb;
                                      -fx-font-size: 11px;
                                      -fx-padding: 3 10;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelScoreCourant" text="Score : 0%"
                               style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    </HBox>

                    <!-- Énoncé -->
                    <Label fx:id="labelEnonce" text=""
                           wrapText="true"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #111827;
                                  -fx-line-spacing: 4;"/>

                    <!-- Options (injectées dynamiquement) -->
                    <VBox fx:id="conteneurOptions" spacing="10"/>
                </VBox>

            </VBox>

            <!-- ── Vue FEEDBACK (après réponse) ── -->
            <VBox fx:id="vueFeedback" alignment="CENTER" spacing="20"
                  style="-fx-padding: 40 80;"
                  visible="false" managed="false">

                <VBox spacing="16"
                      style="-fx-background-color: white;
                             -fx-background-radius: 20;
                             -fx-padding: 36 40;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 4);"
                      maxWidth="800">

                    <!-- Résultat -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label fx:id="iconeFeedback" text="✓"
                               style="-fx-font-size: 32px;"/>
                        <VBox spacing="4">
                            <Label fx:id="labelFeedbackTitre" text="Bonne réponse !"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                            <Label fx:id="labelReponseCorrecte" text=""
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                        </VBox>
                    </HBox>

                    <!-- Explication IA -->
                    <VBox spacing="8"
                          style="-fx-background-color: #f0f9ff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 16;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🤖" style="-fx-font-size: 14px;"/>
                            <Label text="Explication"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
                        </HBox>
                        <Label fx:id="labelExplication" text=""
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151; -fx-line-spacing: 3;"/>
                    </VBox>

                    <!-- Alerte fatigue / anomalie -->
                    <VBox fx:id="alerteFatigue" spacing="6"
                          style="-fx-background-color: #fff7ed;
                                 -fx-background-radius: 10;
                                 -fx-padding: 12 16;"
                          visible="false" managed="false">
                        <Label fx:id="labelAlerteFatigue" text=""
                               style="-fx-font-size: 13px; -fx-text-fill: #ea580c;" wrapText="true"/>
                    </VBox>

                    <!-- Bouton suivant -->
                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="btnSuivant" text="Question suivante →"
                                onAction="#questionSuivante"
                                style="-fx-background-color: #1a0f4f;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 28;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ── Vue CHARGEMENT ── -->
            <VBox fx:id="vueChargement" alignment="CENTER" spacing="20"
                  visible="false" managed="false">
                <ProgressIndicator style="-fx-progress-color: #1a0f4f;" prefWidth="48" prefHeight="48"/>
                <Label text="Génération de la question..." styleClass="user-email"/>
            </VBox>

        </StackPane>
    </center>

    <!-- ===== BAS : ELO en temps réel ===== -->
    <bottom>
        <HBox alignment="CENTER" spacing="40"
              style="-fx-background-color: white;
                     -fx-padding: 12 32;
                     -fx-border-color: #f0f2f8 transparent transparent transparent;
                     -fx-border-width: 1 0 0 0;">
            <HBox spacing="8" alignment="CENTER">
                <Label text="ELO :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="labelEloCourant" text="1000"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER">
                <Label text="Correctes :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="labelNbCorrectes" text="0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER">
                <Label text="Temps moyen :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                <Label fx:id="labelTempsMoyen" text="—"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
