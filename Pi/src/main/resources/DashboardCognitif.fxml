<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.DashboardCognitifController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@style.css">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox prefWidth="210" minWidth="210"
              style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 24 20 24 20;
                         -fx-border-color: transparent transparent #f0f2f8 transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane style="-fx-background-color: #1a0f4f;
                                  -fx-background-radius: 12;"
                           minWidth="36" minHeight="36">
                    <Label text="🧠" style="-fx-font-size: 16px;"/>
                </StackPane>
                <Label text="Cognitif"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a0f4f;"/>
            </HBox>

            <VBox spacing="2" style="-fx-padding: 16 12;" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="nav-item"
                      style="-fx-background-color: #f0f2f8;">
                    <Label text="⊞" style="-fx-font-size: 16px;"/>
                    <Label text="Dashboard" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="nav-item"
                      onMouseClicked="#lancerQuiz" style="-fx-cursor: hand;">
                    <Label text="🎯" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Nouveau Quiz" style="-fx-font-size: 13px; -fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                        <Label text="Mode solo adaptatif" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="nav-item"
                      onMouseClicked="#ouvrirMultijoueur" style="-fx-cursor: hand;">
                    <Label text="🏆" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Multijoueur" style="-fx-font-size: 13px; -fx-text-fill: #d97706; -fx-font-weight: bold;"/>
                        <Label text="Mode compétitif" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="nav-item"
                      onMouseClicked="#retourMenu" style="-fx-cursor: hand;">
                    <Label text="←" style="-fx-font-size: 14px;"/>
                    <Label text="Menu principal" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox style="-fx-border-color: #f0f2f8 transparent transparent transparent;
                         -fx-border-width: 1 0 0 0; -fx-padding: 16 20;" spacing="4">
                <Label fx:id="labelNomUtilisateur" text="Utilisateur"
                       styleClass="user-name"/>
                <Label fx:id="labelNiveauSidebar" text="DEBUTANT"
                       style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 36 32 36;">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="labelTitreDashboard" text="Tableau de bord cognitif"
                               style="-fx-font-size: 26px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1a0f4f;"/>
                        <Label fx:id="labelSousTitre" text="Bienvenue !"
                               styleClass="user-email"/>
                    </VBox>
                    <Button text="🎯  Démarrer un quiz"
                            onAction="#ouvrirChoixQuiz"
                            style="-fx-background-color: #1a0f4f;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 12;
                                   -fx-padding: 12 24;
                                   -fx-font-size: 14px;
                                   -fx-cursor: hand;"/>
                </HBox>

                <!-- Stats ELO Row -->
                <HBox spacing="16">

                    <!-- ELO -->
                    <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <StackPane minWidth="48" minHeight="48"
                                   style="-fx-background-color: #ede9fe; -fx-background-radius: 12;">
                            <Label text="⚡" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="labelElo" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                            <Label text="Cote ELO" styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Taux réussite -->
                    <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <StackPane minWidth="48" minHeight="48"
                                   style="-fx-background-color: #dcfce7; -fx-background-radius: 12;">
                            <Label text="✓" style="-fx-font-size: 20px; -fx-text-fill: #16a34a;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="labelTauxReussite" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                            <Label text="Taux de réussite" styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Sessions totales -->
                    <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <StackPane minWidth="48" minHeight="48"
                                   style="-fx-background-color: #fef3c7; -fx-background-radius: 12;">
                            <Label text="📚" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="labelSessionsTotales" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                            <Label text="Sessions" styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Niveau -->
                    <HBox alignment="CENTER_LEFT" spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <StackPane minWidth="48" minHeight="48"
                                   style="-fx-background-color: #fce7f3; -fx-background-radius: 12;">
                            <Label text="🎓" style="-fx-font-size: 20px;"/>
                        </StackPane>
                        <VBox spacing="3">
                            <Label fx:id="labelNiveau" text="—"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #db2777;"/>
                            <Label text="Niveau actuel" styleClass="user-email"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Ligne : Thèmes + Prédiction -->
                <HBox spacing="16">

                    <!-- Thèmes forts/faibles -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="Analyse thématique"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f0fdf4; -fx-background-radius: 10;
                                         -fx-padding: 16;">
                                <Label text="Point fort" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                                <Label fx:id="labelThemeFort" text="—"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #fff7ed; -fx-background-radius: 10;
                                         -fx-padding: 16;">
                                <Label text="À améliorer" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                                <Label fx:id="labelThemeFaible" text="—"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                            </VBox>
                        </HBox>
                        <Label text="Temps de réponse moyen"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                        <Label fx:id="labelTempsReponse" text="—"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    </VBox>

                    <!-- Prédiction IA -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: linear-gradient(to bottom right, #1a0f4f, #3730a3);
                                 -fx-background-radius: 16;
                                 -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 2);">
                        <Label text="Prédiction IA"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Score estimé dans 3 sessions :"
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                        <Label fx:id="labelPrediction" text="—"
                               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="labelPredictionDetail" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);" wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Historique des sessions -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Dernières sessions"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"
                               HBox.hgrow="ALWAYS"/>
                        <Label text="Voir tout →" style="-fx-text-fill: #2563eb; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- En-têtes du tableau -->
                    <HBox style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10 16;">
                        <Label text="Thème" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" HBox.hgrow="ALWAYS"/>
                        <Label text="Score" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="80"/>
                        <Label text="ELO" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="70"/>
                        <Label text="Fatigue" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="70"/>
                        <Label text="Date" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="100"/>
                    </HBox>

                    <!-- Lignes injectées dynamiquement -->
                    <VBox fx:id="conteneurHistorique" spacing="2"/>

                    <Label fx:id="labelAucuneSession" text="Aucune session pour l'instant. Lancez votre premier quiz !"
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" alignment="CENTER"
                           maxWidth="Infinity" visible="false" managed="false"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
