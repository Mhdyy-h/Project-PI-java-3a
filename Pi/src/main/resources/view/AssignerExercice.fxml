<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20"
      style="-fx-background-color: #f8f6ff; -fx-padding: 40;"
      stylesheets="@../styles/style.css"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.AssignerExerciceController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="🔗" style="-fx-font-size: 36px;"/>
        <VBox spacing="3">
            <Label text="Assigner des Exercices"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;
                          -fx-text-fill: #2d1b69;"/>
            <Label fx:id="labelSeance"
                   style="-fx-font-size: 13px; -fx-text-fill: #9b89a8;"/>
        </VBox>
    </HBox>

    <Label text="──────────────────────────────────────────"
           style="-fx-text-fill: #d4af37; -fx-opacity: 0.5;"/>

    <!-- Exercices déjà assignés -->
    <VBox spacing="8"
          style="-fx-background-color: white; -fx-background-radius: 12;
                 -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.08),10,0,0,2);">
        <Label text="💪 Exercices déjà assignés"
               style="-fx-font-size: 14px; -fx-font-weight: bold;
                      -fx-text-fill: #2d1b69;"/>
        <ListView fx:id="listExercicesAssignes" prefHeight="120"
                  style="-fx-background-color: transparent;
                         -fx-border-color: transparent;"/>
    </VBox>

    <!-- Liste tous les exercices disponibles -->
    <VBox spacing="8"
          style="-fx-background-color: white; -fx-background-radius: 12;
                 -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian,rgba(74,35,90,0.08),10,0,0,2);">
        <Label text="📋 Exercices disponibles"
               style="-fx-font-size: 14px; -fx-font-weight: bold;
                      -fx-text-fill: #2d1b69;"/>
        <Label text="Sélectionnez les exercices à ajouter"
               style="-fx-font-size: 11px; -fx-text-fill: #9b89a8;"/>
        <ListView fx:id="listExercicesDisponibles" prefHeight="200"
                  style="-fx-background-color: transparent;
                         -fx-border-color: transparent;"/>
    </VBox>

    <!-- Séries et répétitions -->
    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="🔢 Séries"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: #4a235a;"/>
            <TextField fx:id="seriesField" promptText="Ex: 3"
                       style="-fx-background-color: white;
                              -fx-border-color: #d4af37; -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-pref-height: 40;
                              -fx-font-size: 13px; -fx-padding: 0 12;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="🔁 Répétitions"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: #4a235a;"/>
            <TextField fx:id="repetitionsField" promptText="Ex: 10"
                       style="-fx-background-color: white;
                              -fx-border-color: #d4af37; -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-pref-height: 40;
                              -fx-font-size: 13px; -fx-padding: 0 12;"/>
        </VBox>
    </HBox>

    <!-- Message -->
    <Label fx:id="messageLabel"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <!-- Boutons -->
    <HBox spacing="12">
        <Button text="➕ Assigner" onAction="#assignerExercice"
                style="-fx-background-color: #2d1b69; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-pref-height: 42; -fx-pref-width: 150;
                       -fx-font-size: 13px;"/>
        <Button text="🗑️ Retirer" onAction="#retirerExercice"
                style="-fx-background-color: #e94560; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-pref-height: 42; -fx-pref-width: 150;
                       -fx-font-size: 13px;"/>
        <Button text="◀ Retour" onAction="#retour"
                style="-fx-background-color: white; -fx-text-fill: #4a235a;
                       -fx-font-weight: bold; -fx-background-radius: 10;
                       -fx-cursor: hand; -fx-pref-height: 42; -fx-pref-width: 120;
                       -fx-border-color: #4a235a; -fx-border-width: 2;
                       -fx-border-radius: 10; -fx-font-size: 13px;"/>
    </HBox>
</VBox>