<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f0f2f8;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserCommunityController">

    <!-- SIDEBAR (Matches Admin Look) -->
    <left>
        <VBox prefWidth="220" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 24 20 24 20; -fx-border-color: transparent transparent #f0f2f8 transparent; -fx-border-width: 0 0 1 0;">
                <Circle fill="#4C6FFF" radius="16" />
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" text="BioSync" />
            </HBox>

            <VBox spacing="4" style="-fx-padding: 16 12 16 12;" VBox.vgrow="ALWAYS">
                <!-- Dashboard Button -->
                <HBox alignment="CENTER_LEFT" onMouseClicked="#handleBackToDashboard" spacing="12" style="-fx-padding: 12 14 12 14; -fx-background-radius: 10; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 16px;" text="⊞" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Dashboard" />
                </HBox>

                <!-- Community Button (Active) -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 12 14 12 14; -fx-background-radius: 10; -fx-background-color: #eef2ff; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 16px;" text="👥" />
                    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4C6FFF;" text="Community" />
                </HBox>
            </VBox>

            <!-- Profile Bottom Area -->
            <VBox spacing="14" style="-fx-padding: 20; -fx-border-color: #f0f2f8 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane>
                        <Circle fill="#4C6FFF" radius="20" />
                        <Label fx:id="userInitialLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="?" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="userNameLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;" text="User" />
                        <Label fx:id="roleLabel" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;" text="Utilisateur" />
                    </VBox>
                </HBox>
                <Label onMouseClicked="#handleLogout" style="-fx-text-fill: #e74c3c; -fx-cursor: hand; -fx-font-weight: bold;" text="→ Logout" />
            </VBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="28" style="-fx-padding: 36 40 36 40;">

                <VBox spacing="4">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" text="Centre Communautaire" />
                    <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Rejoignez des groupes pour optimiser votre rythme circadien" />
                </VBox>

                <!-- BioPoints Card -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 24 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <StackPane style="-fx-background-color: #fff7ed; -fx-background-radius: 14; -fx-padding: 16;">
                        <Label style="-fx-font-size: 28px;" text="🏆" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="userScoreLabel" style="-fx-font-size: 32px; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;" text="Vos BioPoints BioSync" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchField" onKeyReleased="#handleSearch" prefWidth="250" promptText="🔍 Rechercher un groupe..." style="-fx-background-radius: 20; -fx-padding: 10 15;" />
                </HBox>

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Explorer les Groupes" />

                <!-- THE GRID WHERE GROUPS APPEAR -->
                <VBox fx:id="groupsGrid" spacing="15" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>