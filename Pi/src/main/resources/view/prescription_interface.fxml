<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.PrescriptionController"
      spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
    
    <!-- Header -->
    <HBox style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-background-radius: 12; -fx-padding: 20 25 20 25;">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="💊 Gestion des Prescriptions" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="consultationInfoLabel" style="-fx-font-size: 14px; -fx-text-fill: #e8eaf6;"/>
        </VBox>
        <Label fx:id="countLabel" text="Total: 0 prescription(s)" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 8; -fx-padding: 8 15 8 15;"/>
    </HBox>
    
    <!-- Form Section -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4); -fx-padding: 25;" spacing="15">
        <Label text="📝 Ajouter une Prescription" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <GridPane hgap="15" vgap="15">
            <Label text="💊 Médicament:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="medicamentField" promptText="Nom du médicament" style="-fx-font-size: 14px; -fx-padding: 10 12 10 12; -fx-border-radius: 6;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="📏 Dose:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="doseField" promptText="Ex: 500mg, 1 comprimé" style="-fx-font-size: 14px; -fx-padding: 10 12 10 12; -fx-border-radius: 6;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            
            <Label text="⏰ Fréquence:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="frequenceField" promptText="Ex: 2 fois par jour" style="-fx-font-size: 14px; -fx-padding: 10 12 10 12; -fx-border-radius: 6;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            
            <Label text="📅 Durée (jours):" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="dureeField" promptText="Nombre de jours" style="-fx-font-size: 14px; -fx-padding: 10 12 10 12; -fx-border-radius: 6;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            
            <Label text="📋 Instructions:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="instructionsArea" promptText="Instructions spéciales (optionnel)" prefRowCount="3" style="-fx-font-size: 14px; -fx-padding: 10 12 10 12; -fx-border-radius: 6; -fx-wrap-text: true;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
        
        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="addButton" text="➕ Ajouter" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 25 12 25; -fx-font-size: 14px;"/>
            <Button fx:id="saveButton" text="💾 Modifier" style="-fx-background-color: linear-gradient(to right, #3498db, #5dade2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 25 12 25; -fx-font-size: 14px;" visible="false"/>
        </HBox>
    </VBox>
    
    <!-- Prescriptions Table -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4); -fx-padding: 25;" spacing="15">
        <Label text="📋 Prescriptions Actuelles" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <TableView fx:id="prescriptionsTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="medicamentColumn" text="💊 Médicament" prefWidth="150"/>
                <TableColumn fx:id="doseColumn" text="📏 Dose" prefWidth="100"/>
                <TableColumn fx:id="frequenceColumn" text="⏰ Fréquence" prefWidth="120"/>
                <TableColumn fx:id="dureeColumn" text="📅 Durée (jours)" prefWidth="100"/>
                <TableColumn fx:id="instructionsColumn" text="📋 Instructions" prefWidth="200"/>
                <TableColumn fx:id="dateColumn" text="📅 Date" prefWidth="120"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
    
    <!-- Bottom Actions -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Label fx:id="statusLabel" style="-fx-font-size: 14px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="finishButton" text="✅ Terminer et Retourner" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 30 12 30; -fx-font-size: 16px;"/>
    </HBox>
    
</VBox>
