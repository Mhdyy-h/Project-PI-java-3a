<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.LoginController"
           prefWidth="480" prefHeight="680">
    <children>
        <!-- Gradient background -->
        <Rectangle width="480" height="680"
                   fill="linear-gradient(to bottom right, #e0e7ff, #f0fdf4)"/>

        <!-- Card -->
        <VBox alignment="CENTER" spacing="0"
              style="-fx-padding: 0 40 0 40; -fx-max-width: 420;">
            <children>

                <!-- Logo -->
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 28 0;">
                    <children>
                        <Circle radius="10" fill="#4C6FFF"/>
                        <Label text="BioSync"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </children>
                </HBox>

                <!-- White card -->
                <VBox spacing="18" alignment="TOP_CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 6); -fx-padding: 36 36 32 36;">
                    <children>

                        <!-- Title -->
                        <Label text="Inscription"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                        <!-- Full Name -->
                        <VBox fx:id="fullNameBox" spacing="5">
                            <children>
                                <Label text="Nom complet" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 14;">
                                    <children>
                                        <Label text="👤" style="-fx-font-size: 14px;"/>
                                        <TextField fx:id="fullNameField" promptText="Jean Dupont"
                                                   prefHeight="42" HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Adresse email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 14;">
                                    <children>
                                        <Label text="✉" style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;"/>
                                        <TextField fx:id="emailField" promptText="votre@email.com"
                                                   prefHeight="42" HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="5">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="4">
                                    <Label text="Mot de passe" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="suggestPasswordBtn" text="✨ Suggérer" onAction="#handleSuggestPassword"
                                            styleClass="password-suggest-btn" visible="false" managed="false"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="0"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 8 0 14;">
                                    <children>
                                        <Label text="🔒" style="-fx-font-size: 14px;"/>
                                        <StackPane HBox.hgrow="ALWAYS" prefHeight="42">
                                            <PasswordField fx:id="passwordField" promptText="Votre mot de passe"
                                                           prefHeight="42" maxWidth="Infinity"
                                                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                            <TextField fx:id="passwordVisibleField" promptText="Votre mot de passe"
                                                       prefHeight="42" maxWidth="Infinity" visible="false" managed="false"
                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                        </StackPane>
                                        <Button fx:id="eyeToggleBtn" text="👁" onAction="#handleEyeToggle"
                                                styleClass="eye-toggle-btn"/>
                                    </children>
                                </HBox>
                                <!-- Strength bar -->
                                <VBox spacing="3" fx:id="passwordStrengthBox" visible="false" managed="false">
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Region fx:id="passwordStrengthTrack" styleClass="password-strength-track" prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Region fx:id="passwordStrengthFill" styleClass="password-strength-fill" prefWidth="0" maxWidth="-1"/>
                                        <Label fx:id="passwordStrengthLabel" styleClass="password-strength-label" text=""/>
                                    </HBox>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox fx:id="confirmPasswordBox" spacing="5">
                            <children>
                                <Label text="Confirmer le mot de passe" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <HBox alignment="CENTER_LEFT" spacing="0"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 8 0 14;">
                                    <children>
                                        <Label text="🔒" style="-fx-font-size: 14px;"/>
                                        <StackPane HBox.hgrow="ALWAYS" prefHeight="42">
                                            <PasswordField fx:id="confirmPasswordField" promptText="Répétez le mot de passe"
                                                           prefHeight="42" maxWidth="Infinity"
                                                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                            <TextField fx:id="confirmPasswordVisibleField" promptText="Répétez le mot de passe"
                                                       prefHeight="42" maxWidth="Infinity" visible="false" managed="false"
                                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                        </StackPane>
                                        <Button fx:id="confirmEyeToggleBtn" text="👁" onAction="#handleConfirmEyeToggle"
                                                styleClass="eye-toggle-btn"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Terms Checkbox -->
                        <VBox fx:id="termsBox" spacing="4">
                            <children>
                                <CheckBox fx:id="termsCheckBox"
                                          text="J'accepte les conditions d'utilisation"
                                          wrapText="true" prefWidth="340"
                                          style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </children>
                        </VBox>

                        <!-- Forgot password link (login mode only) -->
                        <HBox fx:id="forgotPasswordBox" alignment="CENTER_RIGHT" spacing="4"
                              visible="false" managed="false">
                            <children>
                                <Hyperlink fx:id="forgotPasswordLink" text="Mot de passe oublié ?"
                                           onAction="#handleForgotPassword"
                                           style="-fx-font-size: 11px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <!-- Se souvenir de moi (login mode only, hidden initially) -->
                        <HBox fx:id="registerBox" alignment="CENTER_LEFT" spacing="8"
                              visible="false" managed="false"
                              style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1;">
                            <children>
                                <CheckBox text="Se souvenir de moi"
                                          style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                            </children>
                        </HBox>

                        <!-- Main button -->
                        <Button fx:id="createAccountButton" text="Créer mon compte"
                                onAction="#handleCreateAccount"
                                prefWidth="1000" prefHeight="46"
                                style="-fx-background-color: linear-gradient(to right, #4C6FFF, #06b6d4); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(76,111,255,0.35), 10, 0, 0, 4);"/>

                        <!-- Already have account -->
                        <HBox alignment="CENTER" spacing="4">
                            <children>
                                <Label text="Vous avez déjà un compte?" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                                <Hyperlink fx:id="loginLink" text="Se connecter" onAction="#handleLoginLink"
                                           style="-fx-font-size: 12px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <!-- Demande de certification (toujours visible) -->
                        <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                            <children>
                                <Hyperlink fx:id="healthProLink"
                                           text="Vous êtes un professionnel de santé? Demander une certification"
                                           onAction="#handleHealthProLink"
                                           style="-fx-font-size: 12px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"
                                           wrapText="true"/>
                            </children>
                        </HBox>

                        <!-- Back button (login mode) -->
                        <Button fx:id="backButton" text="← Retour" onAction="#handleBack"
                                prefWidth="1000" prefHeight="38" visible="false" managed="false"
                                style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;"/>

                        <!-- Not registered link (login mode) -->
                        <HBox alignment="CENTER" spacing="4" visible="false" managed="false">
                            <children>
                                <Label text="Pas encore de compte?" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                                <Hyperlink fx:id="registerLink" text="S'inscrire" onAction="#handleRegisterLink"
                                           style="-fx-font-size: 12px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                        <!-- reCAPTCHA indicator -->
                        <HBox fx:id="captchaBox" alignment="CENTER" spacing="8"
                              visible="false" managed="false">
                            <children>
                                <ProgressIndicator fx:id="captchaProgress" prefWidth="18" prefHeight="18"/>
                                <Label fx:id="captchaLabel" text="Vérification de sécurité..."
                                       style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                            </children>
                        </HBox>

                        <!-- Status Label -->
                        <Label fx:id="statusLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" wrapText="true"/>

                        <!-- ===== FACE ID SECTION (only in login mode) ===== -->
                        <VBox fx:id="faceIdSection" spacing="12" alignment="CENTER"
                              visible="false" managed="false"
                              style="-fx-padding: 8 0 0 0;">
                            <children>
                                <!-- Separator with "Ou" -->
                                <HBox alignment="CENTER" spacing="12">
                                    <children>
                                        <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.4;"/>
                                        <Label text="Ou" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                                        <Separator HBox.hgrow="ALWAYS" style="-fx-opacity: 0.4;"/>
                                    </children>
                                </HBox>

                                <Label text="Utilisez votre Face ID"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <Label text="pour vous connecter à votre compte"
                                       style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>

                                <!-- Face ID button -->
                                <Button onAction="#handleFaceId"
                                        prefWidth="72" prefHeight="72"
                                        style="-fx-background-color: transparent; -fx-border-color: #10b981; -fx-border-width: 2.5; -fx-border-radius: 36; -fx-cursor: hand; -fx-background-radius: 36; -fx-font-size: 30px;"
                                        text="🪪"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
