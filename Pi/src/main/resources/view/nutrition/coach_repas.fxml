<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="20"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.CoachRepasController"
      style="-fx-background-color: #f0f2f8; -fx-padding: 24;">

    <!-- Bouton Retour -->
    <HBox>
        <Button text="&#8592; Retour à la liste" onAction="#retournerVersListeUsers"
                style="-fx-background-color: transparent; -fx-text-fill: #4C6FFF;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-border-color: #4C6FFF; -fx-border-radius: 8;
                       -fx-background-radius: 8; -fx-padding: 7 16;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- Carte utilisateur -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <StackPane minWidth="52" minHeight="52"
                   style="-fx-background-color: #e8edff; -fx-background-radius: 50%;">
            <Label fx:id="userInitialeLabel" text="U"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4C6FFF;"/>
        </StackPane>
        <VBox spacing="3">
            <Label fx:id="userNomLabel" text="Utilisateur"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label fx:id="userEmailLabel" text="email@example.com"
                   style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Stats rapides -->
        <HBox spacing="16">
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #e8edff; -fx-background-radius: 10; -fx-padding: 8 16;">
                <Label fx:id="totalRepasLabel" text="0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4C6FFF;"/>
                <Label text="Repas"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #fff3e0; -fx-background-radius: 10; -fx-padding: 8 16;">
                <Label fx:id="totalCaloriesLabel" text="0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                <Label text="Cal/jour"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #d1fae5; -fx-background-radius: 10; -fx-padding: 8 16;">
                <Label fx:id="scoreMoyenLabel" text="0/14"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                <Label text="Score moyen"
                       style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Titre section -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Historique des repas"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Boutons d'action -->
        <Button text="&#x1F4CA; Dashboard" onAction="#ouvrirDashboard"
                style="-fx-background-color: #4C6FFF; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 9 18;
                       -fx-font-size: 13px; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tableau repas -->
    <TableView fx:id="repasTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 12;">
        <columns>
            <TableColumn fx:id="colTitre"    text="Repas"          prefWidth="220" sortable="true"/>
            <TableColumn fx:id="colMoment"   text="Moment"         prefWidth="110" sortable="true"/>
            <TableColumn fx:id="colDate"     text="Date et heure"  prefWidth="180" sortable="true"/>
            <TableColumn fx:id="colPoints"   text="ChronoScore"    prefWidth="110" sortable="true"/>
            <TableColumn fx:id="colCalories" text="Calories"       prefWidth="100" sortable="true"/>
        </columns>
    </TableView>

    <!-- Bouton Voir aliments -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="&#x1F96A; Voir les aliments du repas" onAction="#voirAliments"
                style="-fx-background-color: #10b981; -fx-text-fill: white;
                       -fx-background-radius: 8; -fx-padding: 10 20;
                       -fx-font-size: 13px; -fx-cursor: hand;"/>
    </HBox>

</VBox>
