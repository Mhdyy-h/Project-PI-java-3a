<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.CoachDashboardController"
      style="-fx-background-color: #f0f2f8;">

    <!-- Header fixe -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: white; -fx-padding: 18 28;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
        <Label text="&#x1F4CA;" style="-fx-font-size: 22px;"/>
        <VBox spacing="2">
            <Label text="Dashboard Nutritionnel – Vue Coach"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label fx:id="headerUserLabel" text="Utilisateur"
                   style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="&#x2715; Fermer" onAction="#fermer"
                style="-fx-background-color: #f0f2f8; -fx-text-fill: #6b7280;
                       -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- Stats Cards -->
            <HBox spacing="16">
                <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="Score moyen" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    <Label fx:id="scoreMoyenLabel" text="—"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4C6FFF;"/>
                    <Label text="/14" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="Meilleur score" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    <Label fx:id="meilleurScoreLabel" text="—"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="Pire score" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    <Label fx:id="pireScoreLabel" text="—"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="Alertes actives" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    <Label fx:id="alertesCountLabel" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>
            </HBox>

            <!-- Graphique scores -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <Label text="&#x1F4C8; Évolution des ChronoScores"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;
                              -fx-padding: 0 0 12 0;"/>
                <LineChart fx:id="scoreChart" prefHeight="220" animated="false">
                    <xAxis><CategoryAxis label="Date"/></xAxis>
                    <yAxis><NumberAxis label="Score" lowerBound="0" upperBound="14"/></yAxis>
                </LineChart>
            </VBox>

            <!-- Graphique calories -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <Label text="&#x1F525; Calories par repas (7 derniers jours)"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;
                              -fx-padding: 0 0 12 0;"/>
                <BarChart fx:id="caloriesChart" prefHeight="200" animated="false">
                    <xAxis><CategoryAxis label="Repas"/></xAxis>
                    <yAxis><NumberAxis label="Calories"/></yAxis>
                </BarChart>
            </VBox>

            <!-- Section Alertes -->
            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="&#x26A0;&#xFE0F; Alertes de l'utilisateur"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label fx:id="alertesBadge" text="0"
                           style="-fx-background-color: #f39c12; -fx-text-fill: white;
                                  -fx-background-radius: 20; -fx-padding: 2 10;
                                  -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </HBox>
                <!-- Conteneur des alertes (rempli dynamiquement) -->
                <VBox fx:id="alertesContainer" spacing="8"/>
                <Label fx:id="noAlertesLabel" text="Aucune alerte pour cet utilisateur."
                       style="-fx-text-fill: #9ca3af; -fx-font-size: 13px; -fx-padding: 8 0;"/>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
