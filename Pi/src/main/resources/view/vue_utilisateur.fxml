<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    BioSync – Module Mental Wellness
    Vue Utilisateur (Patient) – Passage de Quiz
    4 écrans empilés dans un StackPane :
      1. screenSelection  – liste des quiz actifs
      2. screenIntro      – présentation du quiz sélectionné
      3. screenQuestion   – question courante + timer circulaire
      4. screenResultat   – score final + récapitulatif
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.VueUtilisateurController"
           fx:id="rootPane"
           prefWidth="940" prefHeight="720"
           style="-fx-background-color: #F5F7FA;"
           stylesheets="@../styles/mental-wellness.css">

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 1 – Sélection du Quiz
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenSelection" maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              spacing="0">

            <!-- Top Bar -->
            <HBox style="-fx-background-color: white;
                          -fx-padding: 22 36 22 36;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                  alignment="CENTER_LEFT" spacing="20">
                <Label text="🧠" style="-fx-font-size: 32px;"/>
                <VBox spacing="3">
                    <Label text="Quiz Mentaux" styleClass="mw-heading-2" style="-fx-text-fill: #34D399;"/>
                    <Label text="Évaluation cognitive – Choisissez votre quiz"
                           styleClass="mw-body-small,mw-text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Retour au Manager" onAction="#handleRetourManager"
                        styleClass="mw-btn-secondary"/>
            </HBox>

            <!-- Wellness Banner -->
            <HBox fx:id="wellnessBanner"
                  style="-fx-background-color: linear-gradient(to right, #ECFDF5, #D1FAE5);
                         -fx-padding: 14 44 14 44;
                         -fx-border-color: #A7F3D0 transparent #A7F3D0 transparent;
                         -fx-border-width: 1 0 1 0;"
                  alignment="CENTER_LEFT" spacing="14">
                <Label fx:id="wellnessEmojiLabel" text="💡" style="-fx-font-size: 18px;"/>
                <Label fx:id="wellnessTipLabel"
                       text="Conseil du jour…"
                       wrapText="true"
                       HBox.hgrow="ALWAYS"
                       style="-fx-font-size: 13px; -fx-text-fill: #065F46; -fx-font-style: italic;"/>
                <Label fx:id="apiSourceLabel" text=""
                       style="-fx-font-size: 10px; -fx-text-fill: #6B7280;
                              -fx-background-color: white; -fx-background-radius: 20;
                              -fx-padding: 3 10 3 10;
                              -fx-border-color: #D1FAE5; -fx-border-width: 1; -fx-border-radius: 20;"/>
            </HBox>

            <!-- Stats Row -->
            <HBox style="-fx-padding: 16 44 0 44; -fx-background-color: transparent;"
                  spacing="16">
                <!-- ELO Card -->
                <HBox style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;
                             -fx-padding: 12 18 12 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);"
                      spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="⚡" style="-fx-font-size: 20px;"/>
                    <VBox spacing="2">
                        <Label text="Score ELO"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="statEloLabel" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #7C6FCD;"/>
                    </VBox>
                </HBox>
                <!-- Taux Réussite Card -->
                <HBox style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;
                             -fx-padding: 12 18 12 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);"
                      spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="🎯" style="-fx-font-size: 20px;"/>
                    <VBox spacing="2">
                        <Label text="Taux Réussite"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="statTauxLabel" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #34D399;"/>
                    </VBox>
                </HBox>
                <!-- Sessions Card -->
                <HBox style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;
                             -fx-padding: 12 18 12 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);"
                      spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                    <VBox spacing="2">
                        <Label text="Sessions"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="statSessionsLabel" text="—"
                               style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1D9E75;"/>
                    </VBox>
                </HBox>
                <!-- Niveau Card -->
                <HBox style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;
                             -fx-padding: 12 18 12 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);"
                      spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="🏅" style="-fx-font-size: 20px;"/>
                    <VBox spacing="2">
                        <Label text="Niveau"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="statNiveauLabel" text="—"
                               style="-fx-font-size: 15px; -fx-font-weight: 900; -fx-text-fill: #6B5EBC;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Search + Filters -->
            <HBox style="-fx-padding: 18 44 0 44;" spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍  Rechercher un quiz…"
                           onKeyReleased="#onSearchChanged"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white;
                                  -fx-border-color: #D1D5DB; -fx-border-width: 1;
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-font-size: 13px; -fx-padding: 9 14 9 14;"/>
                <Button fx:id="btnFilterAll" text="Tous" onAction="#onFilterAll"
                        style="-fx-background-color: #1D9E75; -fx-text-fill: white;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
                <Button fx:id="btnFilterFaible" text="Faible" onAction="#onFilterFaible"
                        style="-fx-background-color: white; -fx-text-fill: #6B7280;
                               -fx-border-color: #D1D5DB; -fx-border-width: 1;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-background-radius: 20; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
                <Button fx:id="btnFilterModere" text="Modéré" onAction="#onFilterModere"
                        style="-fx-background-color: white; -fx-text-fill: #6B7280;
                               -fx-border-color: #D1D5DB; -fx-border-width: 1;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-background-radius: 20; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
                <Button fx:id="btnFilterEleve" text="Élevé" onAction="#onFilterEleve"
                        style="-fx-background-color: white; -fx-text-fill: #6B7280;
                               -fx-border-color: #D1D5DB; -fx-border-width: 1;
                               -fx-font-size: 12px; -fx-font-weight: 600;
                               -fx-background-radius: 20; -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
            </HBox>

            <!-- Count row -->
            <HBox style="-fx-padding: 14 44 4 44;" alignment="CENTER_LEFT" spacing="10">
                <Label text="Quiz disponibles"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #085041;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
            </HBox>

            <!-- Cards Container -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <FlowPane fx:id="quizCardsContainer"
                          hgap="24" vgap="24"
                          style="-fx-padding: 12 44 44 44; -fx-background-color: transparent;"
                          alignment="TOP_LEFT"/>
            </ScrollPane>

            <!-- Empty state label -->
            <Label fx:id="emptyLabel" text="Aucun quiz disponible pour le moment."
                   visible="false" managed="false"
                   styleClass="mw-body,mw-text-muted" style="-fx-padding: 48;"/>
        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 2 – Introduction du Quiz
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenIntro" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              alignment="CENTER" spacing="32"
              style="-fx-padding: 72 88 72 88; -fx-background-color: #F5F7FA;">

            <!-- Brain icon (pulse via CSS) -->
            <Label fx:id="introEmoji" text="🧠"
                   style="-fx-font-size: 72px;"/>

            <!-- Titre -->
            <Label fx:id="introTitre" text="—"
                   styleClass="mw-heading-1" style="-fx-text-fill: #34D399; -fx-text-alignment: center;"
                   wrapText="true" maxWidth="640"/>

            <!-- Description -->
            <Label fx:id="introDescription" text=""
                   styleClass="mw-body,mw-text-muted" style="-fx-text-alignment: center;"
                   wrapText="true" maxWidth="580"/>

            <!-- Stats row -->
            <HBox spacing="72" alignment="CENTER"
                  styleClass="mw-surface-card"
                  style="-fx-padding: 32 56 32 56;">
                <VBox alignment="CENTER" spacing="8">
                    <Label fx:id="introNbQuestions" text="—"
                           style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #34D399;"/>
                    <Label text="Questions" styleClass="mw-caption"/>
                </VBox>
                <VBox alignment="CENTER" spacing="8">
                    <Label text="30" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #34D399;"/>
                    <Label text="Sec / Question" styleClass="mw-caption"/>
                </VBox>
                <VBox alignment="CENTER" spacing="8">
                    <Label fx:id="introDifficulte" text="—"
                           style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #34D399;"/>
                    <Label text="Niveau Stress" styleClass="mw-caption"/>
                </VBox>
            </HBox>

            <!-- Boutons -->
            <ToggleButton fx:id="btnVocal" text="🎤 Mode Vocal : Désactivé"
                          onAction="#toggleVoiceMode"
                          styleClass="mw-voice-btn"
                          style="-fx-background-color: #F0FDF4; -fx-text-fill: #166534;
                                 -fx-border-color: #86EFAC; -fx-border-width: 2px; -fx-border-radius: 12px;"/>
            <Button fx:id="btnDemarrer" text="▶   Démarrer le Quiz"
                    onAction="#demarrerQuiz"
                    styleClass="mw-btn-success"
                    style="-fx-font-size: 18px; -fx-padding: 16px 56px;"/>
            <Button text="← Retour" onAction="#retourSelection"
                    styleClass="mw-btn-ghost"/>
        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 3 – Question courante
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenQuestion" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="28" AnchorPane.bottomAnchor="28"
              AnchorPane.leftAnchor="52" AnchorPane.rightAnchor="52"
              spacing="24">

            <!-- Header : progression + timer -->
            <HBox spacing="24" alignment="CENTER_LEFT">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label fx:id="labelProgression"
                               styleClass="mw-body" style="-fx-font-weight: 700;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelScore"
                               styleClass="mw-body,mw-text-success" style="-fx-font-weight: 700;"/>
                    </HBox>
                    <ProgressBar fx:id="progressQuiz" maxWidth="Infinity" prefHeight="10"
                                 styleClass="mw-progress-bar,mw-progress-bar-success"/>
                </VBox>

                <!-- Focus indicator -->
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="focusIndicatorLabel" text="🟢"
                           style="-fx-font-size: 18px;"/>
                    <Label text="Focus"
                           style="-fx-font-size: 9px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                </VBox>

                <!-- Timer circulaire -->
                <StackPane style="-fx-pref-width: 80; -fx-pref-height: 80;" alignment="CENTER">
                    <Canvas fx:id="timerCanvas" width="80" height="80"/>
                    <Label fx:id="timerLabel" text="30"
                           style="-fx-font-size: 24px; -fx-font-weight: 800;
                                  -fx-text-fill: #34D399;"/>
                </StackPane>
            </HBox>

            <!-- Card question -->
            <VBox VBox.vgrow="ALWAYS"
                  styleClass="mw-surface-card"
                  style="-fx-padding: 32 36 32 36;"
                  spacing="14">
                <Label fx:id="labelNumero"
                       styleClass="mw-badge,mw-badge-success"/>
                <Label fx:id="labelQuestion" text="Chargement…"
                       wrapText="true" VBox.vgrow="ALWAYS"
                       styleClass="mw-body-large" style="-fx-font-weight: 600; -fx-line-spacing: 6px;"/>
            </VBox>

            <!-- Boutons réponses -->
            <VBox fx:id="reponseBox" spacing="12">
                <Button fx:id="btnA" maxWidth="Infinity" prefHeight="56"
                        styleClass="mw-option-btn"
                        userData="A" onAction="#choisirReponse"/>
                <Button fx:id="btnB" maxWidth="Infinity" prefHeight="56"
                        styleClass="mw-option-btn"
                        userData="B" onAction="#choisirReponse"/>
                <Button fx:id="btnC" maxWidth="Infinity" prefHeight="56"
                        styleClass="mw-option-btn"
                        userData="C" onAction="#choisirReponse"/>
                <Button fx:id="btnD" maxWidth="Infinity" prefHeight="56"
                        styleClass="mw-option-btn"
                        userData="D" onAction="#choisirReponse"/>
            </VBox>

        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 4 – Résultat Final
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenResultat" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              alignment="CENTER" spacing="20"
              style="-fx-padding: 40 88 40 88; -fx-background-color: #F5F7FA;">

            <!-- Emoji résultat -->
            <Label fx:id="resultatEmoji" text="🏆"
                   style="-fx-font-size: 72px;"/>

            <!-- Titre et message -->
            <Label fx:id="resultatTitre" text="—"
                   styleClass="mw-heading-1" style="-fx-text-fill: #34D399;"/>
            <Label fx:id="resultatMessage" text=""
                   wrapText="true"
                   styleClass="mw-body,mw-text-muted" style="-fx-text-alignment: center;" maxWidth="520"/>

            <!-- Cercle score (animé count-up) -->
            <StackPane fx:id="scoreCercle"
                       styleClass="mw-score-circle"
                       style="-fx-pref-width: 160; -fx-pref-height: 160;"
                       alignment="CENTER">
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="labelScoreAnime" text="0 / 0"
                           style="-fx-font-size: 30px; -fx-font-weight: 800; -fx-text-fill: #7C6FCD;"/>
                    <Label fx:id="labelPourcentage" text="0%"
                           style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #6B5EBC;"/>
                </VBox>
            </StackPane>

            <!-- Récapitulatif scroll -->
            <ScrollPane fitToWidth="true" maxHeight="200"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-background: transparent;">
                <VBox fx:id="recapContainer" spacing="8"
                      style="-fx-padding: 6 0 6 0;"/>
            </ScrollPane>

            <!-- Anomaly Report Panel -->
            <VBox fx:id="anomalyPanel"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 12;
                         -fx-padding: 14 20 14 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);"
                  spacing="10" maxWidth="Infinity" opacity="0">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🔍 Analyse de Concentration"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="anomalyStatusLabel" text="🟢 OPTIMAL"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #065F46;"/>
                </HBox>
                <HBox spacing="0" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Score Focus"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="focusScoreLabel" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #7C6FCD;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Tps moyen"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="avgTimeLabel" text="—"
                               style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #1D9E75;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Anomalies"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                        <Label fx:id="anomalyCountLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #E24B4A;"/>
                    </VBox>
                </HBox>
                <Label fx:id="anomalyRecommendationLabel" text=""
                       wrapText="true" maxWidth="Infinity"
                       style="-fx-font-size: 12px; -fx-text-fill: #6B7280; -fx-font-style: italic;"/>
                <VBox fx:id="anomalyListContainer" spacing="5"/>
            </VBox>

            <!-- Boutons action -->
            <HBox spacing="18" alignment="CENTER">
                <Button text="🔄  Rejouer" onAction="#rejouer"
                        styleClass="mw-btn-success"/>
                <Button text="← Retour aux Quiz" onAction="#retourSelection"
                        styleClass="mw-btn-secondary"/>
            </HBox>

        </VBox>

        <!-- Confetti overlay (lancé par Java) -->
        <Canvas fx:id="confettiCanvas" mouseTransparent="true"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

    </AnchorPane>

</StackPane>
