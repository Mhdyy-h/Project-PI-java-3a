<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    BioSync – Module Mental Wellness
    Vue Utilisateur (Patient) – Passage de Quiz
    4 écrans empilés dans un StackPane :
      1. screenSelection  – liste des quiz actifs
      2. screenIntro      – présentation du quiz sélectionné
      3. screenQuestion   – question courante + timer circulaire
      4. screenResultat   – score final + récapitulatif
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.VueUtilisateurController"
           fx:id="rootPane"
           prefWidth="940" prefHeight="720"
           style="-fx-background-color: #F0FDF8;">

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 1 – Sélection du Quiz
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenSelection" maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              spacing="0">

            <!-- Top Bar -->
            <HBox style="-fx-background-color: white;
                          -fx-padding: 18 32 18 32;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);"
                  alignment="CENTER_LEFT" spacing="16">
                <Label text="🧠" style="-fx-font-size: 28px;"/>
                <VBox spacing="2">
                    <Label text="Quiz Mentaux" style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #085041;"/>
                    <Label text="Évaluation cognitive – Choisissez votre quiz"
                           style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Retour au Manager" onAction="#handleRetourManager"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                               -fx-font-size: 12px; -fx-background-radius: 8;
                               -fx-padding: 8 16 8 16; -fx-cursor: hand;
                               -fx-border-color: #D1D5DB; -fx-border-width: 1; -fx-border-radius: 8;"/>
            </HBox>

            <!-- Header section -->
            <VBox style="-fx-padding: 32 40 16 40;" spacing="4">
                <Label text="Choisissez votre Quiz"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #085041;"/>
                <Label text="Sélectionnez une évaluation cognitive pour commencer"
                       style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
            </VBox>

            <!-- Cards Container -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <FlowPane fx:id="quizCardsContainer"
                          hgap="20" vgap="20"
                          style="-fx-padding: 8 40 40 40; -fx-background-color: transparent;"
                          alignment="TOP_LEFT"/>
            </ScrollPane>

            <!-- Empty state label -->
            <Label fx:id="emptyLabel" text="Aucun quiz disponible pour le moment."
                   visible="false" managed="false"
                   style="-fx-font-size: 15px; -fx-text-fill: #9CA3AF; -fx-padding: 40;"/>
        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 2 – Introduction du Quiz
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenIntro" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              alignment="CENTER" spacing="24"
              style="-fx-padding: 60 80 60 80; -fx-background-color: #F0FDF8;">

            <!-- Brain icon (pulse via CSS) -->
            <Label fx:id="introEmoji" text="🧠"
                   style="-fx-font-size: 64px;"/>

            <!-- Titre -->
            <Label fx:id="introTitre" text="—"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                          -fx-text-fill: #085041; -fx-text-alignment: center;"
                   wrapText="true" maxWidth="600"/>

            <!-- Description -->
            <Label fx:id="introDescription" text=""
                   style="-fx-font-size: 14px; -fx-text-fill: #555;
                          -fx-text-alignment: center;"
                   wrapText="true" maxWidth="540"/>

            <!-- Stats row -->
            <HBox spacing="60" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                          -fx-border-color: #D1FAE5; -fx-border-width: 1;
                          -fx-border-radius: 16; -fx-padding: 24 48 24 48;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="introNbQuestions" text="—"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/>
                    <Label text="Questions" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6">
                    <Label text="30" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/>
                    <Label text="Sec / Question" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6">
                    <Label fx:id="introDifficulte" text="—"
                           style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/>
                    <Label text="Niveau Stress" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
                </VBox>
            </HBox>

            <!-- Boutons -->
            <Button fx:id="btnDemarrer" text="▶   Démarrer le Quiz"
                    onAction="#demarrerQuiz"
                    style="-fx-background-color: #1D9E75; -fx-text-fill: white;
                           -fx-font-size: 16px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-padding: 14 48 14 48;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(29,158,117,0.4), 10, 0, 0, 3);"/>
            <Button text="← Retour" onAction="#retourSelection"
                    style="-fx-background-color: transparent; -fx-text-fill: #888;
                           -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: transparent;"/>
        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 3 – Question courante
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenQuestion" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="24" AnchorPane.bottomAnchor="24"
              AnchorPane.leftAnchor="48" AnchorPane.rightAnchor="48"
              spacing="20">

            <!-- Header : progression + timer -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="labelProgression"
                               style="-fx-font-size: 14px; -fx-font-weight: 600;
                                      -fx-text-fill: #374151;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelScore"
                               style="-fx-font-size: 13px; -fx-text-fill: #1D9E75;
                                      -fx-font-weight: 600;"/>
                    </HBox>
                    <ProgressBar fx:id="progressQuiz" maxWidth="Infinity" prefHeight="8"
                                 style="-fx-accent: #1D9E75; -fx-background-color: #E5E7EB;
                                        -fx-background-radius: 6;"/>
                </VBox>

                <!-- Timer circulaire -->
                <StackPane style="-fx-pref-width: 72; -fx-pref-height: 72;" alignment="CENTER">
                    <Canvas fx:id="timerCanvas" width="72" height="72"/>
                    <Label fx:id="timerLabel" text="30"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: #1D9E75;"/>
                </StackPane>
            </HBox>

            <!-- Card question -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                          -fx-border-color: #D1FAE5; -fx-border-width: 1;
                          -fx-border-radius: 14; -fx-padding: 28 32 28 32;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                  spacing="12">
                <Label fx:id="labelNumero"
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #1D9E75; -fx-background-color: #D1FAE5;
                              -fx-background-radius: 6; -fx-padding: 4 10 4 10;"/>
                <Label fx:id="labelQuestion" text="Chargement…"
                       wrapText="true" VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 19px; -fx-font-weight: 600;
                              -fx-text-fill: #1A1A1A; -fx-line-spacing: 4;"/>
            </VBox>

            <!-- Boutons réponses -->
            <VBox fx:id="reponseBox" spacing="10">
                <Button fx:id="btnA" maxWidth="Infinity" prefHeight="52"
                        styleClass="btn-reponse"
                        userData="A" onAction="#choisirReponse"/>
                <Button fx:id="btnB" maxWidth="Infinity" prefHeight="52"
                        styleClass="btn-reponse"
                        userData="B" onAction="#choisirReponse"/>
                <Button fx:id="btnC" maxWidth="Infinity" prefHeight="52"
                        styleClass="btn-reponse"
                        userData="C" onAction="#choisirReponse"/>
                <Button fx:id="btnD" maxWidth="Infinity" prefHeight="52"
                        styleClass="btn-reponse"
                        userData="D" onAction="#choisirReponse"/>
            </VBox>

        </VBox>
    </AnchorPane>

    <!-- ═══════════════════════════════════════════════════════
         ÉCRAN 4 – Résultat Final
    ═══════════════════════════════════════════════════════ -->
    <AnchorPane fx:id="screenResultat" visible="false" opacity="0"
                maxWidth="Infinity" maxHeight="Infinity">
        <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              alignment="CENTER" spacing="16"
              style="-fx-padding: 32 80 32 80; -fx-background-color: #F0FDF8;">

            <!-- Emoji résultat -->
            <Label fx:id="resultatEmoji" text="🏆"
                   style="-fx-font-size: 64px;"/>

            <!-- Titre et message -->
            <Label fx:id="resultatTitre" text="—"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #085041;"/>
            <Label fx:id="resultatMessage" text=""
                   wrapText="true"
                   style="-fx-font-size: 14px; -fx-text-fill: #555;
                          -fx-text-alignment: center;" maxWidth="480"/>

            <!-- Cercle score (animé count-up) -->
            <StackPane fx:id="scoreCercle"
                       style="-fx-background-color: #D1FAE5; -fx-background-radius: 70;
                               -fx-pref-width: 140; -fx-pref-height: 140;"
                       alignment="CENTER">
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="labelScoreAnime" text="0 / 0"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1D9E75;"/>
                    <Label fx:id="labelPourcentage" text="0%"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F6E56;"/>
                </VBox>
            </StackPane>

            <!-- Récapitulatif scroll -->
            <ScrollPane fitToWidth="true" maxHeight="180"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-background: transparent;">
                <VBox fx:id="recapContainer" spacing="6"
                      style="-fx-padding: 4 0 4 0;"/>
            </ScrollPane>

            <!-- Boutons action -->
            <HBox spacing="16" alignment="CENTER">
                <Button text="🔄  Rejouer" onAction="#rejouer"
                        style="-fx-background-color: #1D9E75; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-padding: 12 32 12 32;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(29,158,117,0.35), 8, 0, 0, 2);"/>
                <Button text="← Retour aux Quiz" onAction="#retourSelection"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                               -fx-font-size: 14px; -fx-font-weight: 500;
                               -fx-background-radius: 10; -fx-padding: 12 28 12 28;
                               -fx-cursor: hand; -fx-border-color: #D1D5DB;
                               -fx-border-width: 1; -fx-border-radius: 10;"/>
            </HBox>

        </VBox>
    </AnchorPane>

</StackPane>
