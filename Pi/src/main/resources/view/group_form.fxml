<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GroupFormController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: transparent transparent #e2e8f0 transparent;">
            <Button onAction="#handleCancel" text="← Retour" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label fx:id="formTitle" text="Ajouter un Groupe" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20" maxWidth="500" alignment="CENTER_LEFT">
            <padding><Insets top="40" bottom="40"/></padding>
            <VBox spacing="5">
                <Label text="Nom du groupe *" />
                <TextField fx:id="nomField" prefHeight="40" style="-fx-background-radius: 8;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Thématique *" />
                <ComboBox fx:id="themeCombo" prefHeight="40" prefWidth="500" style="-fx-background-radius: 8;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Capacité Max (1-20) *" />
                <TextField fx:id="capaciteField" prefHeight="40" style="-fx-background-radius: 8;"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Description" />
                <TextArea fx:id="descArea" prefHeight="100" style="-fx-background-radius: 8;" wrapText="true"/>
            </VBox>
            <Label fx:id="statusLabel" />
            <Button onAction="#handleSave" prefHeight="45" prefWidth="500" text="Enregistrer" style="-fx-background-color: #4C6FFF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </center>
</BorderPane>