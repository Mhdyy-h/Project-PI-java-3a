<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.GroupFormController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-border-color: transparent transparent #e2e8f0 transparent;">
            <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;" text="← Retour" />
            <Label fx:id="formTitle" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ajouter un Groupe" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox alignment="CENTER_LEFT" maxWidth="600" spacing="20">
                <padding><Insets bottom="40" left="50" right="50" top="40" /></padding>

                <!-- Image Upload Section -->
                <VBox spacing="10">
                    <Label style="-fx-font-weight: bold;" text="Image du Groupe" />
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <StackPane style="-fx-background-color: #e2e8f0; -fx-background-radius: 12; -fx-overflow: hidden;">
                            <ImageView fx:id="imagePreview" fitHeight="120.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="false" />
                        </StackPane>
                        <Button onAction="#handleChooseImage" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="Choisir une image..." />
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="Nom du groupe *" />
                    <TextField fx:id="nomField" prefHeight="40" style="-fx-background-radius: 8;" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Thématique *" />
                    <ComboBox fx:id="themeCombo" prefHeight="40" prefWidth="600" style="-fx-background-radius: 8;" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Capacité Max (1-20) *" />
                    <TextField fx:id="capaciteField" prefHeight="40" style="-fx-background-radius: 8;" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Description" />
                    <TextArea fx:id="descArea" prefHeight="100" style="-fx-background-radius: 8;" wrapText="true" />
                </VBox>

                <Label fx:id="statusLabel" />
                <Button onAction="#handleSave" prefHeight="45" prefWidth="600" style="-fx-background-color: #4C6FFF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Enregistrer" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>