<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.MenuController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../styles/style.css">

    <!-- ===== SIDEBAR GAUCHE ===== -->
    <left>
        <VBox prefWidth="200" minWidth="200"
              style="-fx-background-color: white;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 24 20 24 20;
                         -fx-border-color: transparent transparent #f0f2f8 transparent;
                         -fx-border-width: 0 0 1 0;">
                <Circle radius="16" fill="#1a0f4f"/>
                <Label text="Gestion Sport"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a0f4f;"/>
            </HBox>

            <!-- Nav Items -->
            <VBox spacing="2"
                  style="-fx-padding: 16 12 16 12;"
                  VBox.vgrow="ALWAYS">

                <!-- Dashboard actif -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      style="-fx-background-color: #f0f2f8;">
                    <Label text="⊞" style="-fx-font-size: 16px;"/>
                    <Label text="Dashboard"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a0f4f;"/>
                </HBox>

                <!-- Séances -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirSeances">
                    <Label text="🏃" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Séances"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #c9a227;
                                      -fx-font-weight: bold;"/>
                        <Label text="Gestion séances"
                               style="-fx-font-size: 10px;
                                      -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Exercices -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirExercices">
                    <Label text="💪" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Exercices"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #7d3c98;
                                      -fx-font-weight: bold;"/>
                        <Label text="Gestion exercices"
                               style="-fx-font-size: 10px;
                                      -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Back Office -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      styleClass="nav-item"
                      onMouseClicked="#ouvrirAdmin">
                    <Label text="⚙️" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Back Office"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #e94560;
                                      -fx-font-weight: bold;"/>
                        <Label text="Administration"
                               style="-fx-font-size: 10px;
                                      -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Footer sidebar -->
            <VBox style="-fx-border-color: #f0f2f8 transparent transparent transparent;
                         -fx-border-width: 1 0 0 0;
                         -fx-padding: 16 20 16 20;"
                  spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="18" fill="#1a0f4f"/>
                    <VBox spacing="1">
                        <Label text="Gestion Sport"
                               styleClass="user-name"/>
                        <Label text="Administrateur"
                               styleClass="user-email"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="24"
                  style="-fx-padding: 32 36 32 36;">

                <!-- Header -->
                <VBox spacing="4">
                    <Label text="Dashboard — Gestion Sport"
                           style="-fx-font-size: 26px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a0f4f;"/>
                    <Label text="Vue globale de votre activité sportive"
                           styleClass="user-email"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="20">

                    <!-- Séances -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 24 30 24 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #fff8e7;
                                          -fx-background-radius: 14;">
                            <Label text="🏃" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="totalSeancesLabel" text="—"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #c9a227;"/>
                            <Label text="Total Séances"
                                   styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Exercices -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 24 30 24 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #f5eeff;
                                          -fx-background-radius: 14;">
                            <Label text="💪" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="totalExercicesLabel" text="—"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #7d3c98;"/>
                            <Label text="Total Exercices"
                                   styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Durée moyenne -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 24 30 24 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #e8f8f0;
                                          -fx-background-radius: 14;">
                            <Label text="⏱️" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="moyenneDureeLabel" text="—"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a8a5a;"/>
                            <Label text="Min / Séance"
                                   styleClass="user-email"/>
                        </VBox>
                    </HBox>

                    <!-- Médailles Or -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-padding: 24 30 24 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #fff0f3;
                                          -fx-background-radius: 14;">
                            <Label text="🥇" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="totalMedaillesLabel" text="—"
                                   style="-fx-font-size: 32px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #e94560;"/>
                            <Label text="Médailles Or"
                                   styleClass="user-email"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Action Cards -->
                <HBox spacing="20">

                    <!-- Carte Séances -->
                    <VBox spacing="16" alignment="CENTER"
                          styleClass="card-validations-pro"
                          HBox.hgrow="ALWAYS"
                          onMouseClicked="#ouvrirSeances"
                          style="-fx-cursor: hand;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #fff8e7;
                                          -fx-background-radius: 16;">
                            <Label text="🏃" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Séances Sport"
                                   styleClass="user-name"
                                   style="-fx-font-size: 15px;"/>
                            <Label text="Gérer vos séances d'entraînement"
                                   styleClass="user-email"
                                   wrapText="true"/>
                        </VBox>
                        <Button text="Accéder →"
                                onAction="#ouvrirSeancesNav"
                                styleClass="btn-primary"/>
                    </VBox>

                    <!-- Carte Exercices -->
                    <VBox spacing="16" alignment="CENTER"
                          styleClass="card-validations-pro"
                          HBox.hgrow="ALWAYS"
                          onMouseClicked="#ouvrirExercices"
                          style="-fx-cursor: hand;
                                 -fx-border-color: #f5eeff;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #f5eeff;
                                          -fx-background-radius: 16;">
                            <Label text="💪" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Exercices"
                                   styleClass="user-name"
                                   style="-fx-font-size: 15px;"/>
                            <Label text="Gérer vos exercices physiques"
                                   styleClass="user-email"
                                   wrapText="true"/>
                        </VBox>
                        <Button text="Accéder →"
                                onAction="#ouvrirExercicesNav"
                                styleClass="btn-primary"
                                style="-fx-background-color: #7d3c98;"/>
                    </VBox>

                    <!-- Carte Back Office -->
                    <VBox spacing="16" alignment="CENTER"
                          styleClass="card-validations-pro"
                          HBox.hgrow="ALWAYS"
                          onMouseClicked="#ouvrirAdmin"
                          style="-fx-cursor: hand;
                                 -fx-border-color: #ffe4e8;">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #fff0f3;
                                          -fx-background-radius: 16;">
                            <Label text="⚙️" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Back Office"
                                   styleClass="user-name"
                                   style="-fx-font-size: 15px;"/>
                            <Label text="Administration et statistiques"
                                   styleClass="user-email"
                                   wrapText="true"/>
                        </VBox>
                        <Button text="Accéder →"
                                onAction="#ouvrirAdminNav"
                                styleClass="btn-refuse"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>