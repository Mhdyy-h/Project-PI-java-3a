<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.RendezVousDialogController"
            prefWidth="600" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../style.css">

    <top>
        <!-- Dialog Header -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 24 32 20 32; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            
            <StackPane minWidth="48" minHeight="48"
                       style="-fx-background-color: #dbeafe; -fx-background-radius: 12;">
                <Label text="📅" style="-fx-font-size: 20px;"/>
            </StackPane>
            
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" text="Nouveau Rendez-vous" 
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Remplissez les informations du rendez-vous" 
                       style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
            </VBox>
            
            <Button text="✕" onAction="#handleClose"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 12 8 12; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 32 32 32;">

                <!-- Current Appointment Info (for edit mode) -->
                <VBox fx:id="currentInfoSection" visible="false" spacing="16"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1;">
                    
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="ℹ️" style="-fx-font-size: 14px;"/>
                        <Label text="INFORMATIONS ACTUELLES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    
                    <GridPane hgap="16" vgap="12">
                        <Label text="Date/Heure:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                        <Label fx:id="currentDateLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                               style="-fx-font-size: 13px; -fx-text-fill: #1a1a2e;"/>
                        
                        <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="1" 
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                        <Label fx:id="readOnlyPatientLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                               style="-fx-font-size: 13px; -fx-text-fill: #1a1a2e;"/>
                        
                        <Label text="Spécialiste:" GridPane.columnIndex="0" GridPane.rowIndex="2" 
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                        <Label fx:id="readOnlySpecialisteLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" 
                               style="-fx-font-size: 13px; -fx-text-fill: #1a1a2e;"/>
                    </GridPane>
                </VBox>

                <!-- Patient Selection -->
                <VBox fx:id="patientSection" spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="PATIENT" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <ComboBox fx:id="patientComboBox" prefWidth="536"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Specialist Selection -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="👨‍⚕️" style="-fx-font-size: 14px;"/>
                        <Label text="SPÉCIALISTE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <ComboBox fx:id="specialisteComboBox" prefWidth="536"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Date and Time -->
                <HBox spacing="20">
                    <!-- Date -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="📆" style="-fx-font-size: 14px;"/>
                            <Label text="DATE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                        <DatePicker fx:id="datePicker" prefWidth="250"
                                    style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Time -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⏰" style="-fx-font-size: 14px;"/>
                            <Label text="HEURE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                        <ComboBox fx:id="timeComboBox" prefWidth="250"
                                  style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Mode Consultation -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="🏥" style="-fx-font-size: 14px;"/>
                        <Label text="MODE DE CONSULTATION" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <ComboBox fx:id="modeComboBox" prefWidth="536"
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Location (for in-person) -->
                <VBox fx:id="locationSection" visible="true" spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📍" style="-fx-font-size: 14px;"/>
                        <Label text="LIEU" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <TextField fx:id="lieuTextField" prefWidth="536" promptText="Entrez le lieu de consultation..."
                               style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Motif -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📝" style="-fx-font-size: 14px;"/>
                        <Label text="MOTIF DE CONSULTATION" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <TextArea fx:id="motifTextArea" prefWidth="536" prefHeight="100" promptText="Décrivez le motif de la consultation..."
                              style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16 12 16; -fx-font-size: 13px; -fx-wrap-text: true;"/>
                </VBox>

                <!-- Urgency Level (Auto-calculated from motif) -->
                <VBox fx:id="urgencyDisplaySection" spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="🚨" style="-fx-font-size: 14px;"/>
                        <Label text="NIVEAU D'URGENCE (AUTO)" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-border-radius: 8; -fx-padding: 12 16 12 16; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <Label fx:id="urgencyLevelLabel" text="Faible" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
                        <Label fx:id="urgencyReasonLabel" text="Basé sur le motif de consultation" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                    </HBox>
                </VBox>

                <!-- Validation Error -->
                <Label fx:id="errorLabel" text="" 
                       style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-wrap-text: true; -fx-background-color: #fef2f2; -fx-background-radius: 8; -fx-padding: 12 16 12 16;"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <!-- Action Buttons -->
        <HBox spacing="16" alignment="CENTER_RIGHT" 
              style="-fx-padding: 24 32 24 32; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-background-color: #f8fafc; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1;"/>
            
            <Button fx:id="suggestButton" text="💡 Suggest" onAction="#handleSuggest"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 3);"/>
            
            <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                    style="-fx-background-color: #4C6FFF; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(76,111,255,0.3), 8, 0, 0, 3);"/>
        </HBox>
    </bottom>

</BorderPane>
