<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../styles.css">

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox prefWidth="200" minWidth="200"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 2, 0);">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 24 20 24 20; -fx-border-color: transparent transparent #f0f2f8 transparent; -fx-border-width: 0 0 1 0;">
                <Circle radius="16" fill="#4C6FFF"/>
                <Label text="BioSync" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            </HBox>

            <!-- Nav Items -->
            <VBox spacing="2" style="-fx-padding: 16 12 16 12;" VBox.vgrow="ALWAYS">

                <!-- Dashboard -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-background-color: #f0f2f8; -fx-cursor: hand;">
                    <Label text="⊞" style="-fx-font-size: 16px; -fx-text-fill: #6b7280;"/>
                    <Label text="Dashboard" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <!-- Utilisateurs - CLICKABLE -->
                <HBox fx:id="utilisateursNavItem" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleNavUtilisateurs">
                    <Label text="👤" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Utilisateurs" style="-fx-font-size: 13px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"/>
                        <Label text="Gestion &amp; In..." style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Certifications - CLICKABLE -->
                <HBox fx:id="certificationsNavItem" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleNavCertifications">
                    <Label text="🏅" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Certifications" style="-fx-font-size: 13px; -fx-text-fill: #06b6d4; -fx-font-weight: bold;"/>
                        <Label text="Demandes Pro" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Historique Logs - CLICKABLE -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleHistoriqueLogs">
                    <Label text="🕐" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Logs" style="-fx-font-size: 13px; -fx-text-fill: #8b5cf6; -fx-font-weight: bold;"/>
                        <Label text="Historique" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Rate Limiting - CLICKABLE -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleRateLimiter">
                    <Label text="🔒" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Sécurité" style="-fx-font-size: 13px; -fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                        <Label text="Blocages" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Nutrition - CLICKABLE -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleNavNutrition">
                    <Label text="🥗" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Nutrition" style="-fx-font-size: 13px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                        <Label text="Repas &amp; Aliments" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Gestion RDV - NOT clickable -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-opacity: 0.5;">
                    <Label text="📅" style="-fx-font-size: 14px;"/>
                    <Label text="Gestion RDV" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <!-- Sports - CLICKABLE -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleNavSports">
                    <Label text="⚡" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Sports" style="-fx-font-size: 13px; -fx-text-fill: #f59e0b; -fx-font-weight: bold;"/>
                        <Label text="Séances &amp; Exercices" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Mental - NOT clickable -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-opacity: 0.5;">
                    <Label text="🧠" style="-fx-font-size: 14px;"/>
                    <Label text="Mental" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <!-- IA Mentale - NOT clickable -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-opacity: 0.5;">
                    <Label text="🤖" style="-fx-font-size: 14px;"/>
                    <Label text="IA Mentale" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;"
                      onMouseClicked="#handleNavCommunity">
                    <Label text="👥" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Community" style="-fx-font-size: 13px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                        <Label text="Groupes &amp; Santé" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Theme Toggle -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 12 8 12;">
                <Button fx:id="themeToggleBtn" text="☀" onAction="#handleThemeToggle"
                        styleClass="theme-toggle-btn"
                        style="-fx-background-color: transparent; -fx-text-fill: #4C6FFF; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 6 10;"/>
                <Label text="Mode sombre" style="-fx-font-size: 11px; -fx-text-fill: #6b7280;"/>
            </HBox>

            <!-- Bottom: Admin info + Logout -->
            <VBox style="-fx-border-color: #f0f2f8 transparent transparent transparent; -fx-border-width: 1 0 0 0; -fx-padding: 16 20 16 20;" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <!-- Avatar (StackPane allows both circle+initials OR photo) -->
                    <StackPane fx:id="adminAvatarPane" minWidth="36" minHeight="36">
                        <Circle fx:id="adminAvatarCircle" radius="18" fill="#4C6FFF"/>
                        <Label fx:id="adminInitialLabel" text="AD"
                               style="-fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <!-- Photo overlay (hidden by default, shown if photo_profil set) -->
                        <ImageView fx:id="adminAvatarImage" fitWidth="36" fitHeight="36"
                                   visible="false" managed="true"
                                   style="-fx-clip-path: 'M18,0 A18,18 0 1 1 18,36 A18,18 0 1 1 18,0';">
                            <clip>
                                <Circle radius="18" centerX="18" centerY="18"/>
                            </clip>
                        </ImageView>
                    </StackPane>
                    <VBox spacing="1">
                        <Label fx:id="adminNameLabel" text="Admin"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Administrateur" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6" onMouseClicked="#handleLogout"
                      style="-fx-cursor: hand; -fx-padding: 6 0 0 0;">
                    <Label text="→" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;"/>
                    <Label text="Logout" style="-fx-font-size: 13px; -fx-text-fill: #e74c3c;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 36 32 36;">

                <!-- Page Header -->
                <VBox spacing="4">
                    <Label text="Administration BioSync" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Gestion globale de la plateforme" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <!-- Stats Row -->
                <HBox spacing="20">
                    <!-- Utilisateurs actifs card -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24 30 24 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #e8edff; -fx-background-radius: 14;">
                            <Label text="👥" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="activeUsersLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Utilisateurs actifs" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>

                    <!-- Demandes certification card -->
                    <HBox alignment="CENTER_LEFT" spacing="20"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24 30 24 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <StackPane minWidth="52" minHeight="52"
                                   style="-fx-background-color: #d1fae5; -fx-background-radius: 14;">
                            <Label text="✅" style="-fx-font-size: 22px;"/>
                        </StackPane>
                        <VBox spacing="4">
                            <Label fx:id="certCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Demandes certification" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- Action Cards Row -->
                <HBox spacing="20">

                    <!-- Gérer les membres -->
                    <VBox spacing="16" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32 24 28 24; -fx-border-color: #e8edff; -fx-border-width: 2; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(76,111,255,0.08), 10, 0, 0, 2); -fx-cursor: hand;"
                          HBox.hgrow="ALWAYS" onMouseClicked="#handleGererMembres">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #e8edff; -fx-background-radius: 16;">
                            <Label text="👤" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Gérer les membres" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Liste complète, suppression et gestion des rôles"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-text-alignment: center;"
                                   wrapText="true" maxWidth="180"/>
                        </VBox>
                    </VBox>

                    <!-- Validations Pro -->
                    <VBox fx:id="validationsProCard" spacing="16" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32 24 28 24; -fx-border-color: #d1fae5; -fx-border-width: 2; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(6,182,212,0.08), 10, 0, 0, 2); -fx-cursor: hand;"
                          HBox.hgrow="ALWAYS"
                          onMouseClicked="#handleValidationsPro">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #d1fae5; -fx-background-radius: 16;">
                            <Label text="📋" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Validations Pro" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Approuver et gérer les certificats de santé"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-text-alignment: center;"
                                   wrapText="true" maxWidth="180"/>
                        </VBox>
                    </VBox>

                    <!-- Historique des Logs — NOW CLICKABLE -->
                    <VBox spacing="16" alignment="CENTER"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32 24 28 24; -fx-border-color: #ede9fe; -fx-border-width: 2; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(139,92,246,0.08), 10, 0, 0, 2); -fx-cursor: hand;"
                          HBox.hgrow="ALWAYS"
                          onMouseClicked="#handleHistoriqueLogs">
                        <StackPane minWidth="60" minHeight="60"
                                   style="-fx-background-color: #ede9fe; -fx-background-radius: 16;">
                            <Label text="🕐" style="-fx-font-size: 26px;"/>
                        </StackPane>
                        <VBox spacing="6" alignment="CENTER">
                            <Label text="Historique des Logs" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label text="Traçabilité complète et export PDF de l'activité"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-text-alignment: center;"
                                   wrapText="true" maxWidth="180"/>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Inscriptions récentes -->
                <VBox spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📋" style="-fx-font-size: 16px;"/>
                        <Label text="Inscriptions récentes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>

                    <!-- Table Header -->
                    <HBox style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 10 16 10 16;">
                        <Label text="NOM" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" HBox.hgrow="ALWAYS" prefWidth="200"/>
                        <Label text="EMAIL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" HBox.hgrow="ALWAYS" prefWidth="300"/>
                        <Label text="RÔLE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" prefWidth="120"/>
                    </HBox>

                    <!-- Recent users list -->
                    <VBox fx:id="recentUsersContainer" spacing="0"/>

                    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
