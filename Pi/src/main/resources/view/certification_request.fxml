<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.CertificationRequestController"
            style="-fx-background-color: #e8f0fe; -fx-background: #e8f0fe; -fx-border-color: transparent;"
            prefWidth="520" prefHeight="750">

    <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #e8f0fe; -fx-padding: 30 40 30 40;">

        <!-- Header Logo + Title -->
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 24 0;">
            <StackPane alignment="CENTER">
                <Circle radius="32" fill="#4C6FFF"
                         style="-fx-effect: dropshadow(gaussian, rgba(76,111,255,0.35), 12, 0, 0, 4);"/>
                <Label text="🏆" style="-fx-font-size: 22px;"/>
            </StackPane>
            <Label text="BioSync Pro"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="Demande de certification professionnelle"
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <!-- Main Card -->
        <VBox spacing="20"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0, 0, 4); -fx-padding: 28 32 28 32;">

            <VBox spacing="6">
                <Label text="Certification Professionnelle"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Rejoignez notre réseau de professionnels de santé certifiés pour accompagner nos utilisateurs."
                       style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" wrapText="true"/>
            </VBox>

            <!-- Benefits box -->
            <VBox spacing="8"
                  style="-fx-background-color: #f0f5ff; -fx-background-radius: 12; -fx-padding: 16 18;">
                <Label text="Avantages de la certification:"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <Label text="✓  Accès aux outils d'analyse avancés"
                       style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                <Label text="✓  Gestion de vos patients sur la plateforme"
                       style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                <Label text="✓  Badge professionnel vérifié"
                       style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
                <Label text="✓  Visibilité auprès de notre communauté"
                       style="-fx-font-size: 12px; -fx-text-fill: #374151;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.15;"/>

            <!-- Nom Complet -->
            <VBox spacing="6">
                <Label text="Nom complet"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="nomField" promptText="Ex: Jean Dupont"
                           style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px;"
                           prefHeight="40"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="6">
                <Label text="Adresse email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="emailField" promptText="votre@email.com"
                           style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px;"
                           prefHeight="40"/>
            </VBox>

            <!-- Specialite (ComboBox) -->
            <VBox spacing="6">
                <Label text="Spécialité"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <ComboBox fx:id="specialiteCombo"
                          promptText="Choisissez votre spécialité..."
                          prefWidth="99999" prefHeight="42"
                          style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Motivation -->
            <VBox spacing="6">
                <Label text="Motivation (optionnel)"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextArea fx:id="motivationField"
                          promptText="Pourquoi souhaitez-vous rejoindre BioSync?"
                          prefHeight="90"
                          style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13px;"
                          wrapText="true"/>
            </VBox>

            <!-- Piece jointe (PDF) -->
            <VBox spacing="6">
                <Label text="Document justificatif (PDF)*"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="📎 Parcourir..." onAction="#handleSelectPdf"
                            style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;"/>
                    <Label fx:id="pdfNameLabel" text="Aucun fichier sélectionné"
                           style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;" wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Info box -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #eff6ff; -fx-background-radius: 10; -fx-padding: 14 16;">
                <Label text="ℹ" style="-fx-font-size: 16px; -fx-text-fill: #4C6FFF;"/>
                <VBox spacing="3">
                    <Label text="Vérification des documents"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <Label text="Votre demande sera examinée sous 48-72h par notre équipe."
                           style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" wrapText="true"/>
                </VBox>
            </HBox>

            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>

            <!-- Submit -->
            <Button text="Soumettre ma demande" onAction="#handleSubmit"
                    maxWidth="99999"
                    style="-fx-background-color: linear-gradient(to right, #4C6FFF, #06b6d4); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(76,111,255,0.3), 8, 0, 0, 3);"/>

        </VBox>

        <!-- Footer links -->
        <HBox alignment="CENTER" spacing="5" style="-fx-padding: 16 0 0 0;">
            <Label text="Vous avez déjà un compte?" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
            <Hyperlink text="Se connecter" onAction="#handleGoToLogin"
                       style="-fx-font-size: 13px; -fx-text-fill: #4C6FFF;"/>
        </HBox>

        <Label text="© 2026 BioSync - Santé, Science &amp; Bien-être"
               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-padding: 12 0 0 0;"/>
    </VBox>
</ScrollPane>
