<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="750.0" prefWidth="950.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.EventFormController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <Button onAction="#handleCancel" text="← Retour" style="-fx-background-color: #f8fafc; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Label fx:id="formTitle" text="Planifier un Événement" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30;">
                <VBox spacing="15" maxWidth="600" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
                    <VBox spacing="5">
                        <Label text="Titre de l'événement *" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="titreField" prefHeight="40"/>
                    </VBox>
                    <HBox spacing="20">
                        <VBox HBox.hgrow="ALWAYS"><Label text="Date *"/><DatePicker fx:id="datePicker" prefHeight="40" maxWidth="Infinity"/></VBox>
                        <VBox HBox.hgrow="ALWAYS"><Label text="BioPoints *"/><TextField fx:id="pointsField" prefHeight="40"/></VBox>
                    </HBox>
                    <VBox spacing="5">
                        <Label text="Groupe associé *"/><ComboBox fx:id="groupCombo" prefHeight="40" prefWidth="600"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Lieu (Nom) *"/><TextField fx:id="locationField" prefHeight="40"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Adresse (Cliquez sur la carte ci-dessous)"/>
                        <TextField fx:id="addressField" prefHeight="40" promptText="L'adresse s'affichera ici..."/>
                    </VBox>

                    <!-- THE MAP VIEW -->
                    <VBox spacing="5" style="-fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                        <WebView fx:id="mapView" prefHeight="300" />
                    </VBox>

                    <Label fx:id="statusLabel" />
                    <Button onAction="#handleSave" prefHeight="45" prefWidth="600" text="Enregistrer" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>