<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.QuizResultController"
      prefHeight="640.0" prefWidth="540.0"
      alignment="CENTER"
      style="-fx-background-color: #F5F7FA;">

    <stylesheets>
        <String value="/styles/style.css"/>
    </stylesheets>

    <!-- ══════════ Result Card ══════════ -->
    <VBox alignment="CENTER" spacing="0"
          style="-fx-background-color: white;
                  -fx-background-radius: 20;
                  -fx-border-color: #E5E7EB;
                  -fx-border-width: 1;
                  -fx-border-radius: 20;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 18, 0, 0, 6);
                  -fx-max-width: 480;">

        <!-- ── Gradient Header ── -->
        <VBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to bottom right, #4285F4, #6EC5A6);
                      -fx-background-radius: 20 20 0 0;
                      -fx-padding: 32 40 28 40;">

            <!-- Medal Icon Circle -->
            <StackPane>
                <Circle radius="44"
                        style="-fx-fill: rgba(255,255,255,0.2);"/>
                <Label fx:id="medalIconLabel" text="🏆"
                       style="-fx-font-size: 42px;"/>
            </StackPane>

            <!-- Medal Type Label -->
            <Label fx:id="medalLabel" text="Médaille d'Or"
                   style="-fx-font-size: 22px; -fx-font-weight: 800;
                          -fx-text-fill: white;"/>

            <!-- Quiz Title -->
            <Label fx:id="quizTitleLabel" text="—"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.85);"
                   wrapText="true"/>
        </VBox>

        <!-- ── Body ── -->
        <VBox alignment="CENTER" spacing="22" style="-fx-padding: 30 40 30 40;">

            <!-- Score Block -->
            <HBox alignment="CENTER" spacing="30">
                <!-- Correct answers -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Score"
                           style="-fx-font-size: 12px; -fx-font-weight: 600;
                                  -fx-text-fill: #9CA3AF; -fx-text-transform: uppercase;"/>
                    <Label fx:id="scoreLabel" text="— / —"
                           style="-fx-font-size: 26px; -fx-font-weight: 800;
                                  -fx-text-fill: #1A1A1A;"/>
                </VBox>

                <!-- Divider -->
                <VBox style="-fx-background-color: #E5E7EB; -fx-min-width: 1; -fx-min-height: 48;"/>

                <!-- Percentage -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Résultat"
                           style="-fx-font-size: 12px; -fx-font-weight: 600;
                                  -fx-text-fill: #9CA3AF; -fx-text-transform: uppercase;"/>
                    <Label fx:id="percentageLabel" text="—%"
                           style="-fx-font-size: 26px; -fx-font-weight: 800;
                                  -fx-text-fill: #4285F4;"/>
                </VBox>
            </HBox>

            <!-- Result Message -->
            <Label fx:id="messageLabel" text="—"
                   wrapText="true"
                   style="-fx-font-size: 14px; -fx-font-weight: 600;
                          -fx-text-fill: #059669; -fx-text-alignment: center;"
                   maxWidth="360"/>

            <!-- Statistics Grid -->
            <HBox alignment="CENTER" spacing="16"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 12;
                          -fx-border-color: #E5E7EB; -fx-border-width: 1;
                          -fx-border-radius: 12; -fx-padding: 16 20 16 20;">
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Questions"
                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                    <Label fx:id="totalQuestionsLabel" text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #374151;"/>
                </VBox>
                <VBox style="-fx-background-color: #E5E7EB; -fx-min-width: 1; -fx-min-height: 40;"/>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Correctes"
                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                    <Label fx:id="correctAnswersLabel" text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #6EC5A6;"/>
                </VBox>
                <VBox style="-fx-background-color: #E5E7EB; -fx-min-width: 1; -fx-min-height: 40;"/>
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Incorrectes"
                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;"/>
                    <Label fx:id="incorrectAnswersLabel" text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #EF4444;"/>
                </VBox>
            </HBox>

            <!-- Action Buttons -->
            <VBox spacing="10" alignment="CENTER">
                <Button fx:id="retryButton" text="↺  Recommencer le Quiz"
                        onAction="#handleRetry" prefWidth="300" prefHeight="44"
                        style="-fx-background-color: #4285F4; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: 700;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(66,133,244,0.35), 8, 0, 0, 2);"/>
                <Button fx:id="backButton" text="← Retour aux Quiz"
                        onAction="#handleBack" prefWidth="300" prefHeight="44"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                               -fx-font-size: 14px; -fx-font-weight: 500;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-border-color: #D1D5DB; -fx-border-width: 1;
                               -fx-border-radius: 10;"/>
            </VBox>

        </VBox>
    </VBox>

    <padding>
        <Insets bottom="32" left="32" right="32" top="32"/>
    </padding>
</VBox>
