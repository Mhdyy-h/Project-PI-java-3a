<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.RendezVousController"
            prefWidth="1100" prefHeight="750"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../styles.css">

    <top>
        <!-- Page Header Bar -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 28 36 20 36; -fx-background-color: #f0f2f8;">

            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Gestion des Rendez-vous BioSync" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Planifiez et gérez tous les rendez-vous médicaux" style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="newRdvButton" text="+ Nouveau Rendez-vous" onAction="#handleAddAction"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 8, 0, 0, 3);"/>
                <Button fx:id="exportPdfButton" text="⬇ Exporter PDF" onAction="#handleExportAction"
                        style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.3), 8, 0, 0, 3);"/>
                <Button text="← Retour" onAction="#handleRetour"
                        style="-fx-background-color: white; -fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-background-radius: 10; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-border-width: 1;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 0 36 32 36;">

            <!-- Stats Row -->
            <HBox spacing="20">
                <!-- Today's Appointments -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS">
                    <StackPane minWidth="44" minHeight="44"
                               style="-fx-background-color: #dbeafe; -fx-background-radius: 12;">
                        <Label text="📅" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="todayCountLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Rendez-vous aujourd'hui" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- This Week -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS">
                    <StackPane minWidth="44" minHeight="44"
                               style="-fx-background-color: #dcfce7; -fx-background-radius: 12;">
                        <Label text="📆" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="weekCountLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Cette semaine" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Pending Appointments -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS">
                    <StackPane minWidth="44" minHeight="44"
                               style="-fx-background-color: #fef3c7; -fx-background-radius: 12;">
                        <Label text="⏳" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="pendingCountLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Confirmed Appointments -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS">
                    <StackPane minWidth="44" minHeight="44"
                               style="-fx-background-color: #d1fae5; -fx-background-radius: 12;">
                        <Label text="✅" style="-fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="confirmedCountLabel" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Confirmés" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Search and Filter Bar -->
            <HBox spacing="24" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                <!-- Search Section -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="🔍" style="-fx-font-size: 12px;"/>
                        <Label text="RECHERCHE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <HBox spacing="12">
                        <TextField fx:id="searchField" promptText="Motif, lieu, patient..."
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-font-size: 13px;"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="searchButton" text="Rechercher" onAction="#handleSearchAction"
                                style="-fx-background-color: #4C6FFF; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="clearSearchButton" text="Effacer" onAction="#handleClearSearchAction"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Filter Section -->
                <VBox spacing="8">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="🎯" style="-fx-font-size: 12px;"/>
                        <Label text="FILTRES" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    <HBox spacing="12">
                        <ComboBox fx:id="statutFilter" prefWidth="140" prefHeight="35"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <ComboBox fx:id="specialisteFilter" prefWidth="180" prefHeight="35"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                        <ComboBox fx:id="dateRangeFilter" prefWidth="140" prefHeight="35"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Action Buttons Row -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="refreshButton" text="🔄 Actualiser" onAction="#handleRefreshAction"
                        style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="headerStatusLabel" text="Prêt" style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
            </HBox>

            <!-- Table Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 12 0;">
                    <Label text="📋" style="-fx-font-size: 14px;"/>
                    <Label text="LISTE DES RENDEZ-VOUS" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="countLabel" text="0 rendez-vous" style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-style: italic;"/>
                </HBox>
                
                <TableView fx:id="rendezVousTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date/Heure" prefWidth="150"/>
                        <TableColumn fx:id="motifColumn" text="Motif" prefWidth="200"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
                        <TableColumn fx:id="modeColumn" text="Mode" prefWidth="120"/>
                        <TableColumn fx:id="patientColumn" text="Patient" prefWidth="150"/>
                        <TableColumn fx:id="specialisteColumn" text="Spécialiste" prefWidth="150"/>
                        <TableColumn fx:id="lieuColumn" text="Lieu" prefWidth="150"/>
                        <TableColumn fx:id="urgenceColumn" text="Urgence" prefWidth="80"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <!-- Patient Action Bar -->
        <HBox alignment="CENTER" spacing="16" 
              style="-fx-padding: 20 36 24 36; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            
            <VBox spacing="4" alignment="CENTER">
                <StackPane minWidth="48" minHeight="48"
                           style="-fx-background-color: #fef2f2; -fx-background-radius: 12;">
                    <Label text="×" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </StackPane>
                <Label text="Annuler ma demande" style="-fx-font-size: 11px; -fx-text-fill: #dc2626; -fx-font-weight: 600;"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <VBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="selectedRdvLabel" text="Aucun rendez-vous sélectionné" 
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-font-style: italic;"/>
                <HBox spacing="12">
                    <Button fx:id="editButton" text="Modifier" onAction="#handleEditAction"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 6, 0, 0, 2);"/>
                    <Button fx:id="deleteButton" text="Supprimer" onAction="#handleDeleteAction"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.3), 6, 0, 0, 2);"/>
                </HBox>
            </VBox>
        </HBox>
    </bottom>

</BorderPane>
