<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #0f0f1a;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.GraphiqueProgressionController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #1a1a2e; -fx-padding: 16 20;">
        <Button text="←" onAction="#retourMenu"
                style="-fx-background-color: #2a2a2a; -fx-text-fill: #aaaaaa;
                       -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand;"/>
        <Label text="📊" style="-fx-font-size: 24px;"/>
        <VBox spacing="2">
            <Label fx:id="lblNom"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Graphiques et statistiques détaillées"
                   style="-fx-font-size: 11px; -fx-text-fill: #7d3c98;"/>
        </VBox>
    </HBox>

    <!-- STATS RAPIDES -->
    <HBox spacing="16" style="-fx-padding: 16 20 0 20;">
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12;
                     -fx-padding: 14 24;">
            <Label fx:id="lblTotalSeances"
                   style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Séances totales"
                   style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12;
                     -fx-padding: 14 24;">
            <Label fx:id="lblDureeMoy"
                   style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Durée moyenne"
                   style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: #7d3c98; -fx-background-radius: 12;
                     -fx-padding: 14 24;">
            <Label fx:id="lblNiveau"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="Niveau actuel"
                   style="-fx-text-fill: #ddbbff; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <!-- GRAPHIQUES -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox fx:id="chartsContainer" spacing="16"
              style="-fx-padding: 16 20; -fx-background-color: #0f0f1a;"/>
    </ScrollPane>

</VBox>