<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.LogsStatsController"
            prefWidth="1200" prefHeight="750"
            style="-fx-background-color: #f0f2f8;">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-padding: 20 32 20 32; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <Label text="📊"
                   style="-fx-font-size: 26px;"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Statistiques des Logs"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Analyse complète de l'activité sur BioSync"
                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
            </VBox>
            <Label text="← Retour aux logs"
                   onMouseClicked="#handleRetourLogs"
                   style="-fx-font-size: 13px; -fx-text-fill: #4C6FFF; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 24 32 32 32;">

                <!-- ===== STAT CARDS ROW ===== -->
                <HBox spacing="16">

                    <!-- Total des logs -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <Label text="📁" style="-fx-font-size: 28px;"/>
                        <VBox spacing="2">
                            <Label fx:id="totalLogsLabel" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                            <Label text="Total des logs"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>

                    <!-- Logs aujourd'hui -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <Label text="📅" style="-fx-font-size: 28px;"/>
                        <VBox spacing="2">
                            <Label fx:id="todayLogsLabel" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                            <Label text="Logs aujourd'hui"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>

                    <!-- Cette semaine -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <Label text="🗓" style="-fx-font-size: 28px;"/>
                        <VBox spacing="2">
                            <Label fx:id="weekLogsLabel" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #6366f1;"/>
                            <Label text="Cette semaine"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>

                    <!-- Ce mois -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
                          HBox.hgrow="ALWAYS">
                        <Label text="📈" style="-fx-font-size: 28px;"/>
                        <VBox spacing="2">
                            <Label fx:id="monthLogsLabel" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                            <Label text="Ce mois"
                                   style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- ===== ROW 2: Activity chart + Donut chart ===== -->
                <HBox spacing="20">

                    <!-- Activité par jour (line chart) -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="📝" style="-fx-font-size: 15px;"/>
                            <Label text="Activité par jour (30 derniers jours)"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <Canvas fx:id="activityCanvas" width="520" height="200"/>
                    </VBox>

                    <!-- Répartition par rôle (donut) -->
                    <VBox spacing="12" minWidth="280"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="🍩" style="-fx-font-size: 15px;"/>
                            <Label text="Répartition par rôle"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <Canvas fx:id="donutCanvas" width="280" height="200"/>
                    </VBox>
                </HBox>

                <!-- ===== ROW 3: Top 5 users + Hourly bar chart ===== -->
                <HBox spacing="20">

                    <!-- Top 5 utilisateurs -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="🏆" style="-fx-font-size: 15px;"/>
                            <Label text="Top 5 utilisateurs les plus actifs"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <VBox fx:id="topUsersContainer" spacing="8"/>
                    </VBox>

                    <!-- Distribution horaire -->
                    <VBox spacing="12" minWidth="340"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="🕐" style="-fx-font-size: 15px;"/>
                            <Label text="Distribution horaire"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <Canvas fx:id="hourlyCanvas" width="340" height="180"/>
                    </VBox>
                </HBox>

                <!-- ===== ROW 4: Top 5 actions horizontal bar ===== -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="🎯" style="-fx-font-size: 15px;"/>
                        <Label text="Top 5 des actions les plus fréquentes"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>
                    <Canvas fx:id="actionsCanvas" width="900" height="200"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
