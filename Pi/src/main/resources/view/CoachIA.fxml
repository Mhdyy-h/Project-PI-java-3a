<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox spacing="0"
      prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #F5F7FA;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.CoachIAController">

    <stylesheets>
        <URL value="@/styles/mental-wellness.css"/>
    </stylesheets>

    <!-- HEADER FIXE -->
    <HBox alignment="CENTER_LEFT" spacing="20"
          style="-fx-background-color: white;
                 -fx-padding: 20 28;
                 -fx-border-color: transparent transparent #E5E7EB transparent;
                 -fx-border-width: 0 0 1 0;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
        <Button text="←"
                onAction="#retourDashboard"
                styleClass="mw-btn-secondary"
                style="-fx-padding: 10px 16px;"/>
        <StackPane styleClass="mw-icon-container,mw-icon-success"
                   minWidth="48" minHeight="48">
            <Label text="🏋️" style="-fx-font-size: 24px;"/>
        </StackPane>
        <VBox spacing="3">
            <Label fx:id="lblNomUser"
                   styleClass="mw-heading-3"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="🟢" style="-fx-font-size: 10px;"/>
                <Label text="Coach IA actif — sport uniquement"
                       styleClass="mw-caption,mw-text-success"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- ZONE MESSAGES -->
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: transparent;
                       -fx-background-color: transparent;
                       -fx-border-color: transparent;">
        <VBox fx:id="messagesContainer"
              spacing="16"
              style="-fx-padding: 28 32; -fx-background-color: transparent;"/>
    </ScrollPane>

    <!-- ZONE SAISIE -->
    <HBox spacing="12" alignment="CENTER"
          style="-fx-background-color: white;
                 -fx-padding: 20 28;
                 -fx-border-color: #E5E7EB transparent transparent transparent;
                 -fx-border-width: 1 0 0 0;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, -2);">
        <TextField fx:id="inputMessage"
                   HBox.hgrow="ALWAYS"
                   promptText="Posez votre question sportive..."
                   styleClass="mw-input"
                   style="-fx-font-size: 14px;"/>
        <Button fx:id="btnEnvoyer"
                text="Envoyer ➤"
                onAction="#envoyerMessage"
                styleClass="mw-btn-success"
                style="-fx-padding: 12px 28px;"/>
    </HBox>

</VBox>
