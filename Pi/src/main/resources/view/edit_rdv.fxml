<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.EditRDVController"
            prefWidth="500" prefHeight="450"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@../style.css">

    <top>
        <!-- Dialog Header -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 24 32 20 32; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
            
            <StackPane minWidth="48" minHeight="48"
                       style="-fx-background-color: #dbeafe; -fx-background-radius: 12;">
                <Label text="📅" style="-fx-font-size: 20px;"/>
            </StackPane>
            
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" text="Modifier Rendez-vous" 
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Label text="Modifiez la date, l'heure ou le motif de votre rendez-vous" 
                       style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
            </VBox>
            
            <Button text="✕" onAction="#handleClose"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 12 8 12; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 32 32 32;">

                <!-- Current Appointment Info -->
                <VBox fx:id="currentInfoSection" spacing="16"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1;">
                    
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="ℹ️" style="-fx-font-size: 14px;"/>
                        <Label text="RENDEZ-VOUS ACTUEL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;"/>
                    </HBox>
                    
                    <GridPane hgap="16" vgap="12">
                        <Label text="Date actuelle:" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="currentDateLabel" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #1a1a2e;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        
                        <Label text="Heure actuelle:" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="currentTimeLabel" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #1a1a2e;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        
                        <Label text="Motif actuel:" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="currentMotifLabel" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #1a1a2e;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    </GridPane>
                </VBox>

                <!-- Edit Form -->
                <VBox spacing="20">
                    
                    <!-- Date Selection -->
                    <VBox spacing="8">
                        <Label text="Nouvelle Date *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1a1a2e;"/>
                        <DatePicker fx:id="datePicker" 
                                   promptText="Sélectionnez une date"
                                   style="-fx-font-size: 14px; -fx-padding: 10 12; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>

                    <!-- Time Selection -->
                    <VBox spacing="8">
                        <Label text="Nouvelle Heure *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1a1a2e;"/>
                        <ComboBox fx:id="timeComboBox" 
                                  promptText="Sélectionnez une heure"
                                  style="-fx-font-size: 14px; -fx-padding: 10 12; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>

                    <!-- Motif -->
                    <VBox spacing="8">
                        <Label text="Nouveau Motif *" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1a1a2e;"/>
                        <TextArea fx:id="motifTextArea" 
                                  promptText="Décrivez le motif de votre rendez-vous"
                                  prefRowCount="3"
                                  wrapText="true"
                                  style="-fx-font-size: 14px; -fx-padding: 10 12; -fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <!-- Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 20 32 24 32; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
            <Button text="Annuler" onAction="#handleCancel"
                    style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #6b7280; -fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10 24 10 24; -fx-cursor: hand;"/>
            <Button text="Enregistrer" onAction="#handleSave"
                    style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: white; -fx-background-color: #3b82f6; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10 24 10 24; -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
