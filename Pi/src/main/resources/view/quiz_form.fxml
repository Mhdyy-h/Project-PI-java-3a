<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.QuizFormController"
      prefHeight="600.0" prefWidth="700.0"
      spacing="0"
      style="-fx-background-color: #F5F7FA;">

    <!-- Header -->
    <HBox style="-fx-background-color: white; -fx-padding: 20 24 20 24; -fx-spacing: 8;
                  -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT">
        <VBox>
            <Label fx:id="formTitleLabel" text="Nouveau Quiz"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
            <Label fx:id="formSubtitleLabel" text="Remplissez les informations du quiz mental"
                   style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
        </VBox>
    </HBox>

    <!-- Form Body -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="16" style="-fx-padding: 24;">

            <!-- Titre -->
            <VBox spacing="6">
                <Label text="Titre du Quiz *"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="titleField"
                           promptText="Ex: Gestion du stress quotidien"
                           style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
                <Label fx:id="titleErrorLabel" text=""
                       style="-fx-text-fill: #EF4444; -fx-font-size: 12px;"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Description -->
            <VBox spacing="6">
                <Label text="Description"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextArea fx:id="descriptionArea"
                          promptText="Décrivez l objectif de ce quiz..."
                          prefRowCount="3"
                          style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
            </VBox>

            <!-- Categorie + Difficulte -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Categorie *"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <ComboBox fx:id="categoryCombo" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <Label fx:id="categoryErrorLabel" text=""
                           style="-fx-text-fill: #EF4444; -fx-font-size: 12px;"
                           visible="false" managed="false"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Difficulte *"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <ComboBox fx:id="difficultyCombo" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                </VBox>
            </HBox>

            <!-- Score minimum -->
            <VBox spacing="6">
                <Label text="Score minimum pour reussir (%) *"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <TextField fx:id="passingScoreField"
                           promptText="Ex: 70"
                           prefWidth="200"
                           style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 10 14 10 14; -fx-font-size: 14px;"/>
                <Label fx:id="passingScoreErrorLabel" text=""
                       style="-fx-text-fill: #EF4444; -fx-font-size: 12px;"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Actif -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <CheckBox fx:id="activeCheckBox" selected="true"/>
                <Label text="Quiz actif (visible par les utilisateurs)"
                       style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
            </HBox>

            <!-- Status -->
            <Label fx:id="statusLabel" text=""
                   style="-fx-font-size: 13px;"/>

        </VBox>
    </ScrollPane>

    <!-- Footer Buttons -->
    <HBox style="-fx-background-color: white; -fx-padding: 16 24 16 24; -fx-spacing: 12;
                  -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"
          alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                       -fx-font-size: 13px; -fx-background-radius: 8;
                       -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
        <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                style="-fx-background-color: #4285F4; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-background-radius: 8; -fx-padding: 10 20 10 20;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>