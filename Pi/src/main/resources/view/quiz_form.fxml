<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.QuizFormController"
           style="-fx-background-color: #F5F7FA;"
           prefHeight="680.0" prefWidth="760.0">

    <stylesheets>
        <URL value="@/styles/style.css"/>
    </stylesheets>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="0" alignment="TOP_CENTER" style="-fx-padding: 20 40 32 40;">

            <!-- ══════════ NAVIGATION BAR ══════════ -->
            <HBox style="-fx-background-color: transparent; -fx-padding: 0 0 12 0; -fx-spacing: 8;"
                  alignment="CENTER_LEFT" maxWidth="640">
                <Button text="← Retour aux Quiz" onAction="#handleRetour"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                               -fx-font-size: 13px; -fx-font-weight: 500;
                               -fx-background-radius: 6; -fx-padding: 8 16 8 16;
                               -fx-cursor: hand; -fx-border-color: #D1D5DB;
                               -fx-border-width: 1; -fx-border-radius: 6;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- ══════════ CARD ══════════ -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16;
                          -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 16;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 4);
                          -fx-max-width: 640; -fx-min-width: 560;"
                  spacing="0">

                <!-- Card Header -->
                <VBox style="-fx-background-color: linear-gradient(to right, #4285F4, #5A9BD5);
                              -fx-background-radius: 16 16 0 0; -fx-padding: 28 32 28 32; -fx-spacing: 6;">
                    <Label fx:id="formTitleLabel" text="Nouveau Quiz"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="formSubtitleLabel" text="Remplissez les informations du quiz mental"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>

                <!-- Form Body -->
                <VBox style="-fx-padding: 28 32 24 32;" spacing="20">

                    <!-- ── Titre ── -->
                    <VBox spacing="6">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Titre du Quiz"
                                   style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                        </HBox>
                        <TextField fx:id="titleField"
                                   promptText="Ex: Quiz de Mémoire Visuelle"
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 12 14 12 14; -fx-font-size: 14px;"/>
                        <Label fx:id="titleErrorLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #EF4444;" managed="false" visible="false"/>
                    </VBox>

                    <!-- ── Description ── -->
                    <VBox spacing="6">
                        <Label text="Description"
                               style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <TextArea fx:id="descriptionArea" prefHeight="80" wrapText="true"
                                  promptText="Décrivez l'objectif de ce quiz..."
                                  style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-padding: 12 14 12 14; -fx-font-size: 14px;"/>
                    </VBox>

                    <!-- ── Catégorie + Difficulté ── -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Catégorie"
                                   style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="categoryCombo" maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 14px;"/>
                            <Label fx:id="categoryErrorLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #EF4444;" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Difficulté"
                                   style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="difficultyCombo" maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <!-- ── Score de passage + Statut ── -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Score de Passage (%)"
                                       style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                            </HBox>
                            <TextField fx:id="passingScoreField" text="50"
                                       promptText="0 - 100"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 12 14 12 14; -fx-font-size: 14px;"/>
                            <Label fx:id="passingScoreErrorLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #EF4444;" managed="false" visible="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="BOTTOM_LEFT">
                            <Label text="Statut"
                                   style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <HBox style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 12 14 12 14;"
                                  alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="activeCheckBox" selected="true"
                                          style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                                <Label text="Quiz Actif"
                                       style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ── Status Message ── -->
                    <Label fx:id="statusLabel" text="" wrapText="true"
                           style="-fx-font-size: 13px; -fx-padding: 2 0 0 0;"/>

                </VBox>

                <!-- Divider -->
                <Separator style="-fx-opacity: 0.5;"/>

                <!-- Action Buttons -->
                <HBox style="-fx-padding: 20 32 24 32;" spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Annuler" onAction="#handleCancel"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                                   -fx-font-size: 14px; -fx-font-weight: 500;
                                   -fx-background-radius: 8; -fx-padding: 12 28 12 28;
                                   -fx-cursor: hand; -fx-border-color: #D1D5DB;
                                   -fx-border-width: 1; -fx-border-radius: 8;"/>
                    <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                            style="-fx-background-color: #4285F4; -fx-text-fill: white;
                                   -fx-font-size: 14px; -fx-font-weight: 600;
                                   -fx-background-radius: 8; -fx-padding: 12 32 12 32;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(66,133,244,0.35), 8, 0, 0, 2);"/>
                </HBox>

            </VBox>

        </VBox>
    </ScrollPane>

</StackPane>
