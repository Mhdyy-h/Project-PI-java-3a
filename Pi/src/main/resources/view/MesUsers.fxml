<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" prefWidth="1100" prefHeight="700"
      style="-fx-background-color: #0f0f1a;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.MesUsersController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #1a1a2e; -fx-padding: 16 20;">
        <Button text="←" onAction="#retourMenu"
                style="-fx-background-color: #2a2a2a;
                       -fx-text-fill: #aaaaaa;
                       -fx-background-radius: 8;
                       -fx-padding: 6 12;
                       -fx-cursor: hand;"/>
        <Label text="👥" style="-fx-font-size: 24px;"/>
        <VBox spacing="2">
            <Label fx:id="lblNombreUsers"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Label text="Gérez vos athlètes assignés"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #888888;"/>
        </VBox>
    </HBox>

    <!-- CONTENU -->
    <HBox spacing="20" VBox.vgrow="ALWAYS"
          style="-fx-padding: 20;">

        <!-- Colonne gauche — Mes Users -->
        <VBox spacing="12" prefWidth="520">
            <Label text="✅ Mes Athlètes"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #44cc88;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;">
                <VBox fx:id="listeUsersContainer" spacing="10"
                      style="-fx-padding: 4;"/>
            </ScrollPane>
        </VBox>

        <!-- Séparateur -->
        <Separator orientation="VERTICAL"/>

        <!-- Colonne droite — Users disponibles -->
        <VBox spacing="12" prefWidth="520">
            <Label text="➕ Athlètes disponibles"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #7d3c98;"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent;
                               -fx-background-color: transparent;">
                <VBox fx:id="listeSansCoachContainer" spacing="10"
                      style="-fx-padding: 4;"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>