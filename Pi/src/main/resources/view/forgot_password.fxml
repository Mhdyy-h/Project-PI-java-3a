<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.ForgotPasswordController"
           prefWidth="480" prefHeight="680">
    <children>
        <!-- Gradient background -->
        <Rectangle width="480" height="680"
                   fill="linear-gradient(to bottom right, #e0e7ff, #fef3c7)"/>

        <!-- Card -->
        <VBox alignment="CENTER" spacing="0"
              style="-fx-padding: 0 40 0 40; -fx-max-width: 420;">
            <children>

                <!-- Logo -->
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 28 0;">
                    <children>
                        <Circle radius="10" fill="#4C6FFF"/>
                        <Label text="BioSync"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </children>
                </HBox>

                <!-- White card -->
                <VBox spacing="18" alignment="TOP_CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 20, 0, 0, 6); -fx-padding: 36 36 32 36;">
                    <children>

                        <!-- Icon -->
                        <Label text="🔐" style="-fx-font-size: 40px;"/>

                        <!-- Title -->
                        <Label text="Mot de passe oublié"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Entrez votre email pour recevoir un code de réinitialisation"
                               style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" wrapText="true"
                               alignment="CENTER"/>

                        <!-- Email Field -->
                        <VBox spacing="5">
                            <children>
                                <Label text="Adresse email" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 14;">
                                    <children>
                                        <Label text="✉" style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;"/>
                                        <TextField fx:id="emailField" promptText="votre@email.com"
                                                   prefHeight="42" HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Send Code Button -->
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Button fx:id="sendCodeButton" text="📧 Envoyer le code"
                                        onAction="#handleSendCode"
                                        prefWidth="1000" prefHeight="44"
                                        style="-fx-background-color: linear-gradient(to right, #4C6FFF, #06b6d4); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12; -fx-cursor: hand;"/>
                                <ProgressIndicator fx:id="progressIndicator" prefWidth="28" prefHeight="28"
                                                   visible="false"/>
                            </children>
                        </HBox>

                        <!-- Code + New Password Section (hidden initially) -->
                        <VBox fx:id="codeSection" spacing="14" visible="false" managed="false">
                            <children>
                                <Separator style="-fx-opacity: 0.3;"/>

                                <Label text="Entrez le code reçu par email"
                                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

                                <!-- Code Field -->
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color: #fffbeb; -fx-border-color: #fbbf24; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 14;">
                                    <children>
                                        <Label text="🔑" style="-fx-font-size: 14px;"/>
                                        <TextField fx:id="codeField" promptText="Code à 6 chiffres"
                                                   prefHeight="42" HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>
                                    </children>
                                </HBox>

                                <!-- New Password -->
                                <VBox spacing="5">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="4">
                                            <Label text="Nouveau mot de passe" HBox.hgrow="ALWAYS" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                            <Button fx:id="suggestPasswordBtn" text="✨ Suggérer" onAction="#handleSuggestPassword"
                                                    styleClass="password-suggest-btn" visible="false" managed="false"/>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="0"
                                              style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 8 0 14;">
                                            <children>
                                                <Label text="🔒" style="-fx-font-size: 14px;"/>
                                                <StackPane HBox.hgrow="ALWAYS" prefHeight="42">
                                                    <PasswordField fx:id="newPasswordField" promptText="Minimum 8 caractères"
                                                                   prefHeight="42" maxWidth="Infinity"
                                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                                    <TextField fx:id="newPasswordVisibleField" promptText="Minimum 8 caractères"
                                                               prefHeight="42" maxWidth="Infinity" visible="false" managed="false"
                                                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                                </StackPane>
                                                <Button fx:id="eyeToggleBtn" text="👁" onAction="#handleEyeToggle"
                                                        styleClass="eye-toggle-btn"/>
                                            </children>
                                        </HBox>
                                        <!-- Strength bar -->
                                        <VBox spacing="3" fx:id="passwordStrengthBox" visible="false" managed="false">
                                            <HBox spacing="0" alignment="CENTER_LEFT">
                                                <Region fx:id="passwordStrengthTrack" styleClass="password-strength-track" prefWidth="280" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                            </HBox>
                                            <HBox spacing="6" alignment="CENTER_LEFT">
                                                <Region fx:id="passwordStrengthFill" styleClass="password-strength-fill" prefWidth="0"/>
                                                <Label fx:id="passwordStrengthLabel" styleClass="password-strength-label" text=""/>
                                            </HBox>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Confirm Password -->
                                <VBox spacing="5">
                                    <children>
                                        <Label text="Confirmer le mot de passe" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                                        <HBox alignment="CENTER_LEFT" spacing="0"
                                              style="-fx-background-color: #f8fafc; -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 8 0 14;">
                                            <children>
                                                <Label text="🔒" style="-fx-font-size: 14px;"/>
                                                <StackPane HBox.hgrow="ALWAYS" prefHeight="42">
                                                    <PasswordField fx:id="confirmPasswordField" promptText="Répétez le mot de passe"
                                                                   prefHeight="42" maxWidth="Infinity"
                                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                                    <TextField fx:id="confirmPasswordVisibleField" promptText="Répétez le mot de passe"
                                                               prefHeight="42" maxWidth="Infinity" visible="false" managed="false"
                                                               style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;"/>
                                                </StackPane>
                                                <Button fx:id="confirmEyeToggleBtn" text="👁" onAction="#handleConfirmEyeToggle"
                                                        styleClass="eye-toggle-btn"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Reset Button -->
                                <Button fx:id="resetButton" text="✓ Réinitialiser le mot de passe"
                                        onAction="#handleResetPassword"
                                        prefWidth="1000" prefHeight="44"
                                        style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 12; -fx-cursor: hand;"/>

                                <!-- Resend code -->
                                <HBox alignment="CENTER">
                                    <children>
                                        <Hyperlink text="Renvoyer le code" onAction="#handleResendCode"
                                                   style="-fx-font-size: 11px; -fx-text-fill: #4C6FFF;"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Status Label -->
                        <Label fx:id="statusLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" wrapText="true"/>

                        <!-- Back to Login -->
                        <HBox alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                            <children>
                                <Hyperlink text="← Retour à la connexion" onAction="#handleBackToLogin"
                                           style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
