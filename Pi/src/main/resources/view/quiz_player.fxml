<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controller.QuizPlayerController"
           prefHeight="720.0" prefWidth="1000.0"
           style="-fx-background-color: #F5F7FA;"
           stylesheets="@../styles/mental-wellness.css">

    <!-- ══════════════════════════════════════════════
         VIEW 0 – Mode Selection
    ══════════════════════════════════════════════ -->
    <VBox fx:id="voiceModeView" alignment="CENTER"
          style="-fx-background-color: #F5F7FA;">

        <VBox alignment="CENTER" spacing="40"
              styleClass="mw-surface-glass"
              style="-fx-max-width: 680; -fx-padding: 60 72 60 72;">

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="🧠 BioSync Quiz"
                       styleClass="mw-heading-1"/>
                <Label text="Choisissez votre mode de jeu"
                       styleClass="mw-body,mw-text-muted"/>
            </VBox>

            <!-- Mode Cards -->
            <HBox spacing="28" alignment="CENTER">

                <!-- Normal Mode -->
                <VBox alignment="CENTER" spacing="20"
                      styleClass="mw-card-quiz"
                      style="-fx-min-width: 260; -fx-padding: 40 32 32 32;">
                    <Label text="🖱️" style="-fx-font-size: 56px;"/>
                    <Label text="Mode Normal"
                           styleClass="mw-heading-3"/>
                    <Label text="Répondez avec la souris&#10;ou le clavier"
                           styleClass="mw-body-small,mw-text-muted" style="-fx-text-alignment: center;"
                           wrapText="true" maxWidth="200"/>
                    <Button text="Choisir →" onAction="#startNormalMode"
                            maxWidth="Infinity"
                            styleClass="mw-btn-secondary"/>
                </VBox>

                <!-- Voice Mode -->
                <VBox alignment="CENTER" spacing="20"
                      styleClass="mw-card-quiz"
                      style="-fx-min-width: 260; -fx-padding: 40 32 32 32;
                             -fx-border-color: #7C6FCD; -fx-border-width: 2px;">
                    <Label text="🎤" style="-fx-font-size: 56px;"/>
                    <Label text="Mode Vocal"
                           styleClass="mw-heading-3,mw-text-accent"/>
                    <Label text="Questions lues à voix haute&#10;Réponse simulée par audio"
                           styleClass="mw-body-small,mw-text-accent" style="-fx-text-alignment: center;"
                           wrapText="true" maxWidth="200"/>
                    <Button text="🎤 Activer" onAction="#startVoiceMode"
                            maxWidth="Infinity"
                            styleClass="mw-btn-primary"/>
                </VBox>

            </HBox>
        </VBox>
    </VBox>

    <!-- ══════════════════════════════════════════════
         VIEW 1 – Quiz Selection
    ══════════════════════════════════════════════ -->
    <VBox fx:id="quizSelectionView" style="-fx-padding: 0;" alignment="TOP_CENTER"
          visible="false" managed="false">

        <!-- Top Bar -->
        <HBox style="-fx-background-color: white;
                      -fx-padding: 20 32 20 32;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
              alignment="CENTER_LEFT" spacing="20">
            <StackPane styleClass="mw-icon-container,mw-icon-violet"
                       minWidth="48" minHeight="48">
                <Label text="🧠" style="-fx-font-size: 24px;"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="BioSync – Quiz Mentaux"
                       styleClass="mw-heading-3"/>
                <Label fx:id="welcomeLabel" text="Bienvenue !"
                       styleClass="mw-body-small,mw-text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="roleLabel" text=""
                   styleClass="mw-badge,mw-badge-info"/>
            <Button text="← Tableau de bord" onAction="#handleRetour"
                    styleClass="mw-btn-secondary"/>
        </HBox>

        <!-- Content -->
        <VBox style="-fx-padding: 32 44 32 44;" VBox.vgrow="ALWAYS" spacing="0">

            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 24 0;">
                <Label text="Quiz Disponibles"
                       styleClass="mw-heading-2"/>
                <Label fx:id="statusLabel" text=""
                       styleClass="mw-body-small,mw-text-danger"/>
            </HBox>

            <ScrollPane style="-fx-background-color: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS" fitToWidth="true">
                <VBox fx:id="quizListContainer" spacing="16">
                    <!-- Quiz cards injected dynamically -->
                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>

    <!-- ══════════════════════════════════════════════
         VIEW 2 – Quiz Play
    ══════════════════════════════════════════════ -->
    <VBox fx:id="quizPlayView" style="-fx-background-color: #F5F7FA;"
          alignment="TOP_CENTER" visible="false" managed="false">

        <!-- Header -->
        <HBox style="-fx-background-color: white; -fx-padding: 18 32 18 32;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);"
              alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="quizTitleLabel" text="Quiz"
                   styleClass="mw-heading-3"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✕  Quitter" onAction="#handleBackToQuizzes"
                    styleClass="mw-btn-danger"/>
        </HBox>

        <!-- Progress Bar -->
        <VBox style="-fx-background-color: white; -fx-padding: 16 32 16 32;
                      -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label fx:id="questionNumberLabel" text="Question 1 / 10"
                       styleClass="mw-body" style="-fx-font-weight: 700;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="progressLabel" text="1 / 10"
                       styleClass="mw-body-small,mw-text-muted"/>
            </HBox>
            <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="10" progress="0.1"
                         styleClass="mw-progress-bar"/>
        </VBox>

        <!-- Voice Mode Bar (only visible when voiceMode = true) -->
        <HBox fx:id="voiceBar" visible="false" managed="false"
              styleClass="mw-voice-bar"
              alignment="CENTER_LEFT" spacing="16">
            <Label text="🎤 Mode Vocal"
                   styleClass="mw-body-small" style="-fx-font-weight: 700; -fx-text-fill: #166534;"/>
            <Label fx:id="voiceStatusLabel" text="Prêt"
                   styleClass="mw-body-small" style="-fx-text-fill: #15803D;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="voiceInputButton" text="🎤 Répondre vocalement"
                    onAction="#handleVoiceInput"
                    styleClass="mw-voice-btn"/>
        </HBox>

        <!-- Question Card -->
        <ScrollPane style="-fx-background-color: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS" fitToWidth="true">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 36 44 36 44;" spacing="0">

                <VBox styleClass="mw-surface-card"
                      style="-fx-max-width: 880; -fx-padding: 36 40 32 40;"
                      spacing="28">

                    <!-- Question Text -->
                    <Label fx:id="questionTextLabel"
                           text="Chargement..."
                           wrapText="true"
                           styleClass="mw-body-large" style="-fx-font-weight: 600; -fx-line-spacing: 6px;"/>

                    <!-- Option Buttons -->
                    <VBox spacing="14">
                        <Button fx:id="optionAButton" text="A.  Option A"
                                onAction="#handleOptionA"
                                maxWidth="Infinity" prefHeight="58"
                                styleClass="mw-option-btn"/>
                        <Button fx:id="optionBButton" text="B.  Option B"
                                onAction="#handleOptionB"
                                maxWidth="Infinity" prefHeight="58"
                                styleClass="mw-option-btn"/>
                        <Button fx:id="optionCButton" text="C.  Option C"
                                onAction="#handleOptionC"
                                maxWidth="Infinity" prefHeight="58"
                                styleClass="mw-option-btn"/>
                        <Button fx:id="optionDButton" text="D.  Option D"
                                onAction="#handleOptionD"
                                maxWidth="Infinity" prefHeight="58"
                                styleClass="mw-option-btn"/>
                    </VBox>

                    <!-- Navigation -->
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Button fx:id="previousButton" text="← Précédent"
                                onAction="#handlePreviousQuestion"
                                styleClass="mw-btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="submitButton" text="✓  Terminer le quiz"
                                onAction="#handleSubmitQuiz"
                                visible="false" managed="false"
                                styleClass="mw-btn-success"/>
                        <Button fx:id="nextButton" text="Suivant →"
                                onAction="#handleNextQuestion" disable="true"
                                styleClass="mw-btn-primary"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ══════════════════════════════════════════════
         VIEW 3 – Result (inline fallback)
    ══════════════════════════════════════════════ -->
    <VBox fx:id="resultView" alignment="CENTER"
          style="-fx-background-color: #F5F7FA; -fx-padding: 48;"
          visible="false" managed="false">

        <VBox alignment="CENTER" spacing="28"
              styleClass="mw-surface-glass"
              style="-fx-max-width: 580; -fx-padding: 52 60 52 60;">

            <!-- Medal Badge -->
            <HBox fx:id="medalContainer" alignment="CENTER"
                  styleClass="mw-medal-gold">
                <Label fx:id="medalLabel" text="🥇 Médaille d'Or"
                       style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
            </HBox>

            <Label fx:id="resultTitleLabel" text="—"
                   styleClass="mw-heading-2"
                   wrapText="true"/>

            <VBox alignment="CENTER" spacing="8">
                <Label fx:id="percentageLabel" text="—%"
                       style="-fx-font-size: 60px; -fx-font-weight: 900; -fx-text-fill: #7C6FCD;"/>
                <Label fx:id="scoreLabel" text="— / —"
                       styleClass="mw-body-large,mw-text-muted"/>
            </VBox>

            <Label fx:id="messageLabel" text=""
                   styleClass="mw-body,mw-text-success" style="-fx-font-weight: 700;"
                   wrapText="true"/>

            <HBox spacing="16" alignment="CENTER">
                <Button fx:id="retryButton" text="↺  Recommencer"
                        onAction="#handleRetryQuiz"
                        styleClass="mw-btn-secondary"/>
                <Button text="← Retour aux Quiz"
                        onAction="#handleBackToQuizzes"
                        styleClass="mw-btn-primary"/>
            </HBox>

        </VBox>
    </VBox>

</StackPane>
