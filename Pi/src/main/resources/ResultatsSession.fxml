<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.ResultatsSessionController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f2f8;"
            stylesheets="@style.css">

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: white;
                     -fx-padding: 16 32;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 4, 0, 0, 2);">
            <Label text="Résultats de la session"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠  Dashboard"
                    onAction="#retourDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
            <Button text="🎯  Nouveau quiz"
                    onAction="#nouveauQuiz"
                    style="-fx-background-color: #1a0f4f; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-background-radius: 10;
                           -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ===== CONTENU ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 28 36;">

                <!-- Ligne 1 : Score + ELO + Fatigue -->
                <HBox spacing="16">

                    <!-- Score final -->
                    <VBox spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
                        <Label fx:id="labelScoreEmoji" text="🎉"
                               style="-fx-font-size: 36px;"/>
                        <Label fx:id="labelScoreFinal" text="—"
                               style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
                        <Label text="Score final" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                        <Label fx:id="labelNbBonnes" text="— / — bonnes réponses"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    </VBox>

                    <!-- ELO Delta -->
                    <VBox spacing="8" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
                        <Label text="⚡" style="-fx-font-size: 30px;"/>
                        <HBox alignment="CENTER" spacing="8">
                            <Label fx:id="labelEloAvant" text="—"
                                   style="-fx-font-size: 20px; -fx-text-fill: #9ca3af;"/>
                            <Label text="→" style="-fx-font-size: 16px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="labelEloApres" text="—"
                                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                        </HBox>
                        <Label fx:id="labelEloDelta" text=""
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="Cote ELO" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                    <!-- Fatigue + temps -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
                        <Label text="Données biométriques"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⚡" style="-fx-font-size: 14px;"/>
                            <Label text="Fatigue finale :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="labelFatigueFinal" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="⏱" style="-fx-font-size: 14px;"/>
                            <Label text="Temps moyen :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="labelTempsMoyen" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🕐" style="-fx-font-size: 14px;"/>
                            <Label text="Durée totale :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="labelDureeSession" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="❓" style="-fx-font-size: 14px;"/>
                            <Label text="Questions :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="labelNbQuestions" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Ligne 2 : Coaching IA + Chat -->
                <HBox spacing="16">

                    <!-- Coaching IA -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: linear-gradient(to bottom right, #1a0f4f, #3730a3);
                                 -fx-background-radius: 16; -fx-padding: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 2);">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="🤖" style="-fx-font-size: 18px;"/>
                            <Label text="Coaching IA"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </HBox>
                        <Label fx:id="labelCoaching" text="Analyse en cours..."
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.85); -fx-line-spacing: 4;"/>

                        <VBox fx:id="conteneurRecommandations" spacing="6"/>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="📄  Exporter PDF"
                                    onAction="#exporterPDF"
                                    style="-fx-background-color: rgba(255,255,255,0.15);
                                           -fx-text-fill: white; -fx-font-size: 12px;
                                           -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Chat assistant -->
                    <VBox spacing="12" prefWidth="360" minWidth="320"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="💬" style="-fx-font-size: 16px;"/>
                            <Label text="Posez une question"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" prefHeight="180" minHeight="160"
                                    style="-fx-background-color: #f9fafb; -fx-background-radius: 8;
                                           -fx-background: #f9fafb; -fx-border-color: transparent;">
                            <VBox fx:id="conteneurChat" spacing="8" style="-fx-padding: 10;"/>
                        </ScrollPane>

                        <HBox spacing="8" alignment="CENTER">
                            <TextField fx:id="champChat" promptText="Votre question..."
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8; -fx-padding: 8 12;
                                              -fx-border-color: #e5e7eb; -fx-border-radius: 8;
                                              -fx-font-size: 13px;"/>
                            <Button text="Envoyer"
                                    onAction="#envoyerMessage"
                                    style="-fx-background-color: #1a0f4f; -fx-text-fill: white;
                                           -fx-background-radius: 8; -fx-padding: 8 16;
                                           -fx-font-size: 12px; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Ligne 3 : Tableau détail questions -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <Label text="Détail des réponses"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a0f4f;"/>

                    <!-- En-têtes -->
                    <HBox style="-fx-background-color: #f9fafb; -fx-background-radius: 8; -fx-padding: 10 16;">
                        <Label text="#" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="30"/>
                        <Label text="Question" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" HBox.hgrow="ALWAYS"/>
                        <Label text="Résultat" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="80"/>
                        <Label text="Temps" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="70"/>
                        <Label text="Difficulté" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #6b7280;" minWidth="80"/>
                    </HBox>

                    <!-- Lignes dynamiques -->
                    <VBox fx:id="conteneurDetailQuestions" spacing="2"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
