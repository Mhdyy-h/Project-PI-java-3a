<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserController">
    <children>
        <Label text="Database Connection Test" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <Label text="Username:"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>
        
        <Label text="Email:"/>
        <TextField fx:id="emailField" promptText="Enter email"/>
        
        <Button text="Test Database Connection" onAction="#testDatabaseConnection"/>
        <Button text="Save User" onAction="#saveUser"/>
        
        <Label fx:id="statusLabel" text="Status: Ready" style="-fx-text-fill: blue;"/>
    </children>
</VBox>