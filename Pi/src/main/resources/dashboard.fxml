<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController"
            prefWidth="1200" prefHeight="760"
            style="-fx-background-color: #f0f2f8;">

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox prefWidth="220" minWidth="220"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 2, 0);">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 26 20 26 20; -fx-border-color: transparent transparent #f0f2f8 transparent; -fx-border-width: 0 0 1 0;">
                <StackPane minWidth="36" minHeight="36"
                           style="-fx-background-color: #4C6FFF; -fx-background-radius: 10;">
                    <Label text="B" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="BioSync" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Administration" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                </VBox>
            </HBox>

            <!-- Nav Items -->
            <VBox spacing="2" style="-fx-padding: 16 12 16 12;" VBox.vgrow="ALWAYS">

                <!-- Dashboard (actif) -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10;
                             -fx-background-color: #e8edff; -fx-cursor: hand;">
                    <Label text="⊞" style="-fx-font-size: 15px; -fx-text-fill: #4C6FFF;"/>
                    <Label text="Dashboard" style="-fx-font-size: 13px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Utilisateurs -->
                <HBox fx:id="utilisateursNavItem" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-cursor: hand;"
                      onMouseClicked="#handleNavUtilisateurs">
                    <Label text="👤" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Utilisateurs" style="-fx-font-size: 13px; -fx-text-fill: #4C6FFF; -fx-font-weight: bold;"/>
                        <Label text="Gestion &amp; Inscriptions" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Certifications -->
                <HBox fx:id="certificationsNavItem" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-cursor: hand;"
                      onMouseClicked="#handleNavCertifications">
                    <Label text="🏅" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Certifications" style="-fx-font-size: 13px; -fx-text-fill: #06b6d4; -fx-font-weight: bold;"/>
                        <Label text="Demandes Pro" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Nutrition -->
                <HBox fx:id="nutritionNavItem" alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-cursor: hand;"
                      onMouseClicked="#handleNavNutrition">
                    <Label text="🥗" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Nutrition" style="-fx-font-size: 13px; -fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                        <Label text="Repas &amp; Calories" style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <!-- Alertes globales -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-cursor: hand;"
                      onMouseClicked="#handleScrollToAlertes">
                    <Label text="⚠️" style="-fx-font-size: 14px;"/>
                    <VBox spacing="1">
                        <Label text="Alertes" style="-fx-font-size: 13px; -fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                        <Label fx:id="sidebarAlertesLabel" text="0 actives"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-padding: 8 0;"/>

                <!-- Gestion RDV (disabled) -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-opacity: 0.4;">
                    <Label text="📅" style="-fx-font-size: 14px;"/>
                    <Label text="Gestion RDV" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-opacity: 0.4;">
                    <Label text="⚡" style="-fx-font-size: 14px;"/>
                    <Label text="Sports" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 11 14 11 14; -fx-background-radius: 10; -fx-opacity: 0.4;">
                    <Label text="🧠" style="-fx-font-size: 14px;"/>
                    <Label text="Mental" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Bottom : User info + Logout -->
            <VBox style="-fx-border-color: #f0f2f8 transparent transparent transparent;
                         -fx-border-width: 1 0 0 0; -fx-padding: 16 20 16 20;" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane>
                        <Circle radius="20" fill="#4C6FFF"/>
                        <Label fx:id="adminInitialLabel" text="AD"
                               style="-fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="adminNameLabel" text="Admin"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="adminRoleLabel" text="Administrateur"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8" onMouseClicked="#handleLogout"
                      style="-fx-cursor: hand; -fx-padding: 4 0 0 0;">
                    <Label text="→" style="-fx-font-size: 14px; -fx-text-fill: #e74c3c;"/>
                    <Label text="Déconnexion" style="-fx-font-size: 13px; -fx-text-fill: #e74c3c;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 30 32 32 32;">

                <!-- ── PAGE HEADER ── -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Tableau de bord"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="dateLabel" text="Chargement..."
                               style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                    <Button text="↻  Actualiser" onAction="#handleRefresh"
                            style="-fx-background-color: white; -fx-text-fill: #4C6FFF;
                                   -fx-font-weight: bold; -fx-background-radius: 10;
                                   -fx-border-color: #e8edff; -fx-border-width: 2; -fx-border-radius: 10;
                                   -fx-padding: 10 20; -fx-cursor: hand;"/>
                </HBox>

                <!-- ── 4 STATS CARDS ── -->
                <HBox spacing="16">

                    <!-- Utilisateurs -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                                 -fx-cursor: hand;"
                          onMouseClicked="#handleGererMembres">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane minWidth="46" minHeight="46"
                                       style="-fx-background-color: #e8edff; -fx-background-radius: 13;">
                                <Label text="👥" style="-fx-font-size: 20px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="activeUsersLabel" text="0"
                                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                <Label text="Utilisateurs actifs"
                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="usersGrowthLabel" text="—"
                               style="-fx-font-size: 11px; -fx-text-fill: #10b981;"/>
                    </VBox>

                    <!-- Certifications -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane minWidth="46" minHeight="46"
                                       style="-fx-background-color: #d1fae5; -fx-background-radius: 13;">
                                <Label text="🏅" style="-fx-font-size: 20px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="certCountLabel" text="0"
                                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                <Label text="Certifications en attente"
                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                            </VBox>
                        </HBox>
                        <Label text="→ Valider les demandes Pro"
                               style="-fx-font-size: 11px; -fx-text-fill: #06b6d4; -fx-cursor: hand;"
                               onMouseClicked="#handleNavCertifications"/>
                    </VBox>

                    <!-- Total Repas -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane minWidth="46" minHeight="46"
                                       style="-fx-background-color: #fef3c7; -fx-background-radius: 13;">
                                <Label text="🍽️" style="-fx-font-size: 20px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="totalRepasLabel" text="0"
                                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                                <Label text="Repas enregistrés (total)"
                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="repasJourLabel" text="—"
                               style="-fx-font-size: 11px; -fx-text-fill: #f39c12;"/>
                    </VBox>

                    <!-- Alertes actives -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane minWidth="46" minHeight="46"
                                       style="-fx-background-color: #fee2e2; -fx-background-radius: 13;">
                                <Label text="⚠️" style="-fx-font-size: 20px;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="alertesCountLabel" text="0"
                                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                <Label text="Alertes actives (7 jours)"
                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                            </VBox>
                        </HBox>
                        <Label fx:id="alertesRougeLabel" text="—"
                               style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                    </VBox>

                </HBox>

                <!-- ── 2 GRAPHIQUES ── -->
                <HBox spacing="16">

                    <!-- Graphique répartition des rôles -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👥" style="-fx-font-size: 15px;"/>
                            <Label text="Répartition des rôles"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <BarChart fx:id="rolesChart" prefHeight="230" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis label="Rôle"/></xAxis>
                            <yAxis><NumberAxis label="Nombre"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Graphique alertes par jour -->
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📈" style="-fx-font-size: 15px;"/>
                            <Label text="Alertes des 7 derniers jours"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </HBox>
                        <BarChart fx:id="alertesChart" prefHeight="230" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis label="Jour"/></xAxis>
                            <yAxis><NumberAxis label="Alertes"/></yAxis>
                        </BarChart>
                    </VBox>

                </HBox>

                <!-- ── UTILISATEURS RÉCENTS  +  ALERTES RÉCENTES ── -->
                <HBox spacing="16">

                    <!-- Tableau utilisateurs récents -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📋" style="-fx-font-size: 15px;"/>
                            <Label text="Inscriptions récentes"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Voir tous →"
                                   style="-fx-font-size: 11px; -fx-text-fill: #4C6FFF; -fx-cursor: hand;"
                                   onMouseClicked="#handleNavUtilisateurs"/>
                        </HBox>

                        <!-- En-tête du tableau -->
                        <HBox style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 10 14;">
                            <Label text="NOM"   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" prefWidth="170"/>
                            <Label text="EMAIL" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" prefWidth="210"/>
                            <Label text="RÔLE"  style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" prefWidth="100"/>
                            <Label text="SCORE" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9ca3af;" prefWidth="70"/>
                        </HBox>

                        <VBox fx:id="recentUsersContainer" spacing="0"/>
                        <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                    </VBox>

                    <!-- Alertes récentes globales -->
                    <VBox spacing="14" prefWidth="340" minWidth="290"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="⚠️" style="-fx-font-size: 15px;"/>
                            <Label text="Alertes récentes"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            <Label fx:id="alertesBadge" text="0"
                                   style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                          -fx-background-radius: 20; -fx-padding: 2 9;
                                          -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        </HBox>

                        <VBox fx:id="recentAlertesContainer" spacing="8"/>
                        <Label fx:id="noAlertesLabel" text="Aucune alerte récente 🎉"
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                    </VBox>

                </HBox>

                <!-- ── ACTIONS RAPIDES ── -->
                <HBox spacing="16">

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28 20; -fx-border-color: #e8edff; -fx-border-width: 2;
                                 -fx-border-radius: 16; -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(76,111,255,0.08), 8, 0, 0, 2);"
                          onMouseClicked="#handleGererMembres">
                        <StackPane minWidth="54" minHeight="54"
                                   style="-fx-background-color: #e8edff; -fx-background-radius: 15;">
                            <Label text="👤" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Gérer les membres"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Liste, rôles, suppression"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" wrapText="true" maxWidth="160"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28 20; -fx-border-color: #d1fae5; -fx-border-width: 2;
                                 -fx-border-radius: 16; -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.08), 8, 0, 0, 2);"
                          onMouseClicked="#handleNavCertifications">
                        <StackPane minWidth="54" minHeight="54"
                                   style="-fx-background-color: #d1fae5; -fx-background-radius: 15;">
                            <Label text="🏅" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Certifications Pro"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Approuver les demandes santé"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" wrapText="true" maxWidth="160"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28 20; -fx-border-color: #fef3c7; -fx-border-width: 2;
                                 -fx-border-radius: 16; -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(243,156,18,0.08), 8, 0, 0, 2);"
                          onMouseClicked="#handleNavNutrition">
                        <StackPane minWidth="54" minHeight="54"
                                   style="-fx-background-color: #fef3c7; -fx-background-radius: 15;">
                            <Label text="🥗" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Module Nutrition"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Repas, alertes &amp; ChronoScore"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" wrapText="true" maxWidth="160"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16;
                                 -fx-padding: 28 20; -fx-border-color: #ede9fe; -fx-border-width: 2;
                                 -fx-border-radius: 16; -fx-opacity: 0.55;">
                        <StackPane minWidth="54" minHeight="54"
                                   style="-fx-background-color: #ede9fe; -fx-background-radius: 15;">
                            <Label text="🕐" style="-fx-font-size: 24px;"/>
                        </StackPane>
                        <Label text="Historique des Logs"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Traçabilité — bientôt disponible"
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;" wrapText="true" maxWidth="160"/>
                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
