<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.QuestionManagerController"
      prefHeight="720.0" prefWidth="1200.0"
      style="-fx-background-color: #F5F7FA;">

    <stylesheets>
        <URL value="@/styles/style.css"/>
    </stylesheets>

    <!-- ══════════ TOP BAR / BREADCRUMB ══════════ -->
    <HBox style="-fx-background-color: white; -fx-padding: 14 24 14 24; -fx-spacing: 10;
                  -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;
                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 2);"
          alignment="CENTER_LEFT">

        <Label text="Quiz Mentaux"
               style="-fx-font-size: 13px; -fx-text-fill: #4285F4; -fx-cursor: hand;"/>
        <Label text=" › "
               style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
        <Label text="Questions"
               style="-fx-font-size: 13px; -fx-text-fill: #1A1A1A; -fx-font-weight: 600;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label fx:id="quizTitleLabel" text="Quiz : —"
                   style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #1A1A1A;"/>
            <Label fx:id="questionCountLabel" text="0 question(s)"
                   style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
        </VBox>

        <Button text="← Retour aux Quiz" onAction="#handleRetour"
                style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                       -fx-font-size: 13px; -fx-font-weight: 500;
                       -fx-background-radius: 8; -fx-padding: 10 18 10 18;
                       -fx-cursor: hand; -fx-border-color: #D1D5DB;
                       -fx-border-width: 1; -fx-border-radius: 8;"/>
    </HBox>

    <!-- ══════════ CONTENT: Split Panel ══════════ -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- ─────────── LEFT PANEL: Question List ─────────── -->
        <VBox style="-fx-background-color: white; -fx-padding: 20 0 0 0;
                      -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;"
              prefWidth="620" HBox.hgrow="ALWAYS">

            <HBox style="-fx-padding: 0 20 16 20;" alignment="CENTER_LEFT" spacing="12">
                <Label text="Liste des Questions"
                       style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1A1A1A;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalPointsLabel" text="0 pts total"
                       style="-fx-font-size: 12px; -fx-text-fill: #6B7280;
                              -fx-background-color: #F3F4F6; -fx-background-radius: 12;
                              -fx-padding: 4 10 4 10;"/>
            </HBox>

            <TableView fx:id="questionTable"
                       style="-fx-background-color: transparent; -fx-border-color: #E5E7EB;
                              -fx-border-width: 1 0 0 0;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn"            text="#"         prefWidth="45"/>
                    <TableColumn fx:id="questionTextColumn"  text="Question"  prefWidth="300"/>
                    <TableColumn fx:id="correctAnswerColumn" text="Réponse"   prefWidth="90"/>
                    <TableColumn fx:id="pointsColumn"        text="Pts"       prefWidth="55"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                        <Label text="❓" style="-fx-font-size: 36px;"/>
                        <Label text="Aucune question pour ce quiz"
                               style="-fx-text-fill: #9CA3AF; -fx-font-size: 14px;"/>
                        <Label text="Ajoutez la première question →"
                               style="-fx-text-fill: #4285F4; -fx-font-size: 13px;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ─────────── RIGHT PANEL: Question Form ─────────── -->
        <VBox fx:id="questionForm"
              style="-fx-background-color: white; -fx-padding: 24 24 24 24;"
              prefWidth="500" spacing="0">

            <!-- Panel Header -->
            <HBox style="-fx-padding: 0 0 20 0; -fx-border-color: #E5E7EB;
                          -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                <VBox>
                    <Label fx:id="formPanelTitleLabel" text="Nouvelle Question"
                           style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1A1A1A;"/>
                    <Label text="Remplissez tous les champs requis *"
                           style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
                </VBox>
            </HBox>

            <ScrollPane style="-fx-background-color: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS" fitToWidth="true">
                <VBox spacing="16" style="-fx-padding: 20 0 0 0;">

                    <!-- Question Text -->
                    <VBox spacing="5">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Question"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                        </HBox>
                        <TextArea fx:id="questionTextArea" prefHeight="72" wrapText="true"
                                  promptText="Entrez le texte de la question..."
                                  style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        <Label fx:id="questionErrorLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #EF4444;"
                               managed="false" visible="false"/>
                    </VBox>

                    <!-- Options A & B -->
                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="A"
                                       style="-fx-background-color: #EFF6FF; -fx-text-fill: #4285F4;
                                              -fx-font-weight: bold; -fx-font-size: 12px;
                                              -fx-background-radius: 5; -fx-padding: 2 7 2 7;"/>
                                <Label text="Option A *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            </HBox>
                            <TextField fx:id="optionAField" promptText="Réponse A"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="B"
                                       style="-fx-background-color: #F0FDF4; -fx-text-fill: #059669;
                                              -fx-font-weight: bold; -fx-font-size: 12px;
                                              -fx-background-radius: 5; -fx-padding: 2 7 2 7;"/>
                                <Label text="Option B *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            </HBox>
                            <TextField fx:id="optionBField" promptText="Réponse B"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <!-- Options C & D -->
                    <HBox spacing="12">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="C"
                                       style="-fx-background-color: #FEF3C7; -fx-text-fill: #D97706;
                                              -fx-font-weight: bold; -fx-font-size: 12px;
                                              -fx-background-radius: 5; -fx-padding: 2 7 2 7;"/>
                                <Label text="Option C *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            </HBox>
                            <TextField fx:id="optionCField" promptText="Réponse C"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="D"
                                       style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626;
                                              -fx-font-weight: bold; -fx-font-size: 12px;
                                              -fx-background-radius: 5; -fx-padding: 2 7 2 7;"/>
                                <Label text="Option D *"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            </HBox>
                            <TextField fx:id="optionDField" promptText="Réponse D"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="optionsErrorLabel" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #EF4444;"
                           managed="false" visible="false"/>

                    <!-- Correct Answer + Points -->
                    <HBox spacing="16">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Réponse Correcte"
                                       style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                                <Label text="*" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;"/>
                            </HBox>
                            <ComboBox fx:id="correctAnswerCombo" maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-border-color: #D1D5DB;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 13px;"/>
                        </VBox>
                        <VBox spacing="5" prefWidth="100">
                            <Label text="Points"
                                   style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="pointsField" text="1" prefWidth="100"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <!-- Explanation -->
                    <VBox spacing="5">
                        <Label text="Explication  (optionnel)"
                               style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <TextArea fx:id="explanationArea" prefHeight="64" wrapText="true"
                                  promptText="Expliquez pourquoi cette réponse est correcte..."
                                  style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- Action Buttons + Status -->
            <VBox spacing="8" style="-fx-padding: 16 0 0 0;
                                       -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
                <HBox spacing="10">
                    <Button fx:id="saveButton" text="Ajouter la Question"
                            onAction="#handleSaveQuestion"
                            style="-fx-background-color: #4285F4; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: 600;
                                   -fx-background-radius: 8; -fx-padding: 12 20 12 20;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(66,133,244,0.35), 6, 0, 0, 2);"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="Effacer" onAction="#handleClearForm"
                            style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                                   -fx-font-size: 13px; -fx-background-radius: 8;
                                   -fx-padding: 12 18 12 18; -fx-cursor: hand;
                                   -fx-border-color: #D1D5DB; -fx-border-width: 1;
                                   -fx-border-radius: 8;"/>
                </HBox>
                <Label fx:id="statusLabel" text="" wrapText="true"
                       style="-fx-font-size: 13px;"/>
            </VBox>

        </VBox>
    </HBox>

</VBox>
